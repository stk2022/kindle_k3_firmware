# VNC daemon and relatives.
#
start_ufbvncd()
{
	if [ -x "${UFBVNCD}" ]; then
		${UFBVNCD} &
		if [ $? ] ; then
			echo $! >${UFBVNCD_PIDFILE}
		fi
	fi
}

stop_ufbvncd()
{
	if [ -r "${UFBVNCD_PIDFILE}" ]; then
		kill_by_pidfile ${UFBVNCD_PIDFILE}
	fi
}

start_vnc()
{
	if ( has_Ethernet ) || [ -e /mnt/us/ENABLE_VNC ]; then
		start_ufbvncd
	fi
}

stop_vnc()
{
		stop_ufbvncd
}

# Platform startup/shutdown begin/end.
#
platform_startup_begin()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}|${RCS_FLAGS_SYSTEM_STARTUP}))`

	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
}

# pass anything as argument 1 if "mntroot_ro" is required
platform_startup_end()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}&~${RCS_FLAGS_SYSTEM_STARTUP}))`
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}

	if [ -n "$1" ] ; then
		mntroot_ro
	fi
}

platform_shutdown_begin()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}|${RCS_FLAGS_SYSTEM_SHUTDOWN}))`
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
}

platform_shutdown_end()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}&~${RCS_FLAGS_SYSTEM_SHUTDOWN}))`
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
	mntroot_ro
}

platform_software_update_begin()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}|${RCS_FLAGS_SOFTWARE_UPDATE}))`
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
}

platform_software_update_end()
{
	update_rcs_info
	RCS_FLAGS=`echo $((${RCS_FLAGS}&~${RCS_FLAGS_SOFTWARE_UPDATE}))`
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
}

platform_end()
{
	RCS_FLAGS=${RCS_FLAGS_CLEAR}
	
	echo ${RCS_FLAGS} >${RCS_FLAGS_CTRL}
}

# System.
#
dirty_reboot()
{
	platform_end
	
	# If the Framework was shut down cleanly, then clear
	# our boot global to set things up properly for the
	# next time we boot up.
	#
	if ( is_Framework_Stopped ); then
		echo 0 > ${FRAMEWORK_STOPPED}
	fi
	
	# Do the reboot itself if we're supposed to.
	#
	if [ $# -eq 0 ]; then
		sysreboot --reboot
	fi
}

clean_reboot()
{
	# For scripts that need to cleanly reboot the system without going through
	# the normal reboot levels process, they must perform a kernel toggle first.
	#
	if [ -e /etc/init.d/kernel_toggle ]; then 
		/etc/init.d/kernel_toggle stop
	else
		msg	"/etc/init.d/kernel_toggle not found" E
	fi

	dirty_reboot $@
}

shutdown_framework()
{
	shutdown_framework_reboot_screen=$1
	
	# Shut the Framwork down without clearing the screen if it's still running.
	#
	if ( is_Framework_Running ); then
		platform_shutdown_begin
		wait_framework_done
		platform_shutdown_end
	fi
	
	# Display a screen on reboot if requested.
	#
	case $shutdown_framework_reboot_screen in
		$SHUTDOWN_FRAMEWORK_REBOOT_SCREEN)
			display_reboot_screen
			reboot_screen_asis
			;;
		
		$SHUTDOWN_FRAMEWORK_AMAZON_SCREEN)
			display_amazon_screen
			sleep_screen
			reboot_screen_asis
			;;
		
		$SHUTDOWN_FRAMEWORK_CLROFF_SCREEN)
			${EIPS} -c
			sleep_screen
			reboot_screen_asis
			;;
		
		*)
			;;
	esac
}

internal_features_enabled()
{
	[ -f $INTERNAL_FLAG_FILE ]
	return $?
}

# Usage: is_wlan0_ready
is_wlan0_ready()
{
    local MAC=`ifconfig wlan0 2> /dev/null | awk '$4 == "HWaddr" {print $5}'`
    case "$MAC" in
        ''|00:00:00:00:00:00)
            return 1
            ;;
    esac
    return 0
}

