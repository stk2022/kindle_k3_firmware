	fi	  
}

wake_framework()
{
	# If the Power Daemon is sleeping, attempt to wake it up by faking a
	# power-key press.
	#
	if ( is_PowerD_Sleeping ); then
		powerd_test -p
		sleep 1
	fi
	
	# If the Framework is (still) sleeping, wake the input devices and the screen.
	#
	if ( is_Framework_Sleeping ); then
		wake_input_devices
		wake_screen
		sleep 1
	fi
}

wait_framework_done_guts()
{
	_TERM_RETRIES=5
	_COUNT=0

	while [ ${_COUNT} -lt ${_TERM_RETRIES} ]; do

		sleep 1

		if [ -z "`pidof ${CVM}`" ]; then
			return
		fi

		_COUNT=`expr ${_COUNT} + 1`

	done

	killall -KILL ${CVM} >/dev/null 2>/dev/null
}

wait_framework_done()
{
	${FRAMEWORK} stop

	wait_framework_done_guts
}

kill_by_pidfile()
{
	PIDFILE=$1
	
	kill -TERM `cat ${PIDFILE}` >/dev/null 2>/dev/null && sleep 1
	kill -KILL `cat ${PIDFILE}` >/dev/null 2>/dev/null
}

update_screen_info()
{
	if [ -c ${SCREEN} ]; then
		SCREEN_X_RES=`${FBSET} | ${AWK} '/geometry/ { print $2 }'`
		SCREEN_Y_RES=`${FBSET} | ${AWK} '/geometry/ { print $3 }'`
		SCREEN_DEPTH=`${FBSET} | ${AWK} '/geometry/ { print $6 }'`
	else
		SCREEN_X_RES=0
		SCREEN_Y_RES=0
		SCREEN_DEPTH=0
	fi
	
	case ${SCREEN_Y_RES} in
	
		# Switch to larger size if necessary.
		#
		${EINK_SCREEN_Y_RES_N})
			EIPS_Y_UPDATE_FAILURE=${EIPS_Y_UPDATE_FAILURE_N}
			;;

	esac
	
	if [ -f ${EINK_DEBUG_CTRL} ]; then
		EINK_DEBUG=`cat ${EINK_DEBUG_CTRL}`
	else
		EINK_DEBUG=0
	fi

	# Use the old panel_size boot-global if progress_count doesn't exist.
	#
	if [ ! -f ${EINK_PROGRESSBAR_COUNT} ]; then
		EINK_PROGRESSBAR_COUNT=/proc/bd/panel_size
	fi
}

update_rcs_info()
{
	let RCS_FLAGS=0x`cat ${RCS_FLAGS_CTRL}`

	SYSTEM_STARTUP=`echo $((${RCS_FLAGS_SYSTEM_STARTUP}&${RCS_FLAGS}))`
	SYSTEM_SHUTDOWN=`echo $((${RCS_FLAGS_SYSTEM_SHUTDOWN}&${RCS_FLAGS}))`
	VIDEO_STARTUP=`echo $((${RCS_FLAGS_VIDEO_STARTUP}&${RCS_FLAGS}))`
	SOFTWARE_UPDATE=`echo $((${RCS_FLAGS_SOFTWARE_UPDATE}&${RCS_FLAGS}))`
}

eink_rom_is_flash()
{
	# Assume ROM is indeed read-only.
	#
	eink_rom_is_flash_result=$FALSE
	
	# If the ROM/Flash proc entries are available...
	#
	if [ -f "${EINK_ROM}" ] && [ -f "${EINK_ROM_IS_FLASH}" ]; then
		rom_is_flash=`cat ${EINK_ROM_IS_FLASH}`
		
		# ...say it's flash (read/write) when it truly is.
		#
		if [ $rom_is_flash -ne 0 ]; then
			eink_rom_is_flash_result=$TRUE
		fi
	fi
	
	return $eink_rom_is_flash_result
}

eink_restart()
{
	if [ -f ${VIDEO} ]; then
		${VIDEO} start_all
	fi
}

eink_restart_check()
{
	restart_eink=0
	
	# If the screen isn't available at all, say we need to restart
	# the eInk controller.
	#
	if [ ! -c ${SCREEN} ]; then
		restart_eink=1
	else

		if [ -f ${EINK_BOOTSTRAP_INFO} ]; then
			eink_bootstrap_info=`cat ${EINK_BOOTSTRAP_INFO}`
			eink_preflight_info=`cat ${EINK_PREFLIGHT_INFO}`
			
			# If we've been artificially put into bootstrapping mode (to keep
			# the screen as is from the last reboot), then say that we need
			# to be restarted.
			#
			if [ $eink_bootstrap_info -ne 0 ] && [ $eink_preflight_info -eq 0 ]; then
				restart_eink=1
			fi
		fi
	fi

	# Say that we need to restart the eInk HAL if we're still sleeping at this point.
	#
	if [ -f ${EINK_WAKE_FILE} ]; then
		restart_eink=1
	fi

	# Go restart eInk if we've determined that's what we need to.
	#
	if [ ${restart_eink} -eq 1 ]; then
		eink_restart
	fi

	# Update eInk flash if that's what we need to do.
	#
	if [ -f ${EINK_UPDATE_FILE} ]; then
		rm -f ${EINK_UPDATE_FILE}
		${EINK_UPDATE_FLASH}
	fi
}

# Boot progress.
#
progress_debug()
{
	# If there's something to debug and eInk-debugging is enabled, show whose progress
	# we're updating.
	#
	update_screen_info
	
	if [ -n "$1" ] && [ ${EINK_DEBUG} -ne 0 ]; then
		let eips_x=$(( ((${SCREEN_X_RES}-${PROGRESSBAR_WIDTH})/2)/${EIPS_X_RES} + 2))
		let eips_y=$(( (${SCREEN_Y_RES}/${EIPS_Y_RES} * 4)/5 + 2))
		
		${EIPS} -n $eips_x $eips_y "${EIPS_CLEAR_STRING}"
		${EIPS} $eips_x $eips_y "$1"
		
		msg "RCS_FLAGS = ${RCS_FLAGS}" D
	fi
}

update_boot_progress()
{
	update_rcs_info
	
	# Only draw the boot progressbar when we're starting up and aren't doing a software update.
	#
	if [ ${SYSTEM_STARTUP} -ne 0 ] && [ ${SOFTWARE_UPDATE} -eq 0 ] && [ -f ${EINK_PROGRESSBAR_CTRL} ]; then
		let progress_count=0x`cat ${EINK_PROGRESSBAR_COUNT}`
		let progress=`cat ${EINK_PROGRESSBAR_CTRL}`
		
		# Vacillate between incrementing the progressbar by 1 or 2 based on how many times we've
		# already tried to update it.
		#
		if [ $(($progress_count % 2)) -eq 0 ]; then
			let progress+=1
		else
			let progress+=2
		fi
		
		let progress_count+=1
		progress_count=`printf "%08X" $progress_count`
		echo $progress_count >${EINK_PROGRESSBAR_COUNT}
		
		# Ensure that starting the Framework up is the last startup-script to
		# increment the boot progress, and peg the progress to 50% to prevent
		# overshooting where the Framework is supposed to start.
		#
		framework_started=`cat ${FRAMEWORK_STARTED}`
		
		if [ $framework_started -ne 1 ] && [ $progress -le ${MAX_BOOT_PROGRESS} ]; then
			echo $progress >${EINK_PROGRESSBAR_CTRL}
			progress_debug "$1"
		fi
	fi
}

set_boot_progress()
{
	update_rcs_info
	
	# Only draw the boot progressbar when we're starting up and aren't doing a software update.
	#
	if [ ${SYSTEM_STARTUP} -ne 0 ] && [ ${SOFTWARE_UPDATE} -eq 0 ] && [ -f ${EINK_PROGRESSBAR_CTRL} ]; then
		let progress=`cat ${EINK_PROGRESSBAR_CTRL}`
		
		# Only let the progressbar go up, and not passed 100%.
		#
		if [ $1 -ge $progress ] && [ $1 -le 100 ]; then
			let progress=$1
		
			echo $progress >${EINK_PROGRESSBAR_CTRL}
			progress_debug "$2"
		fi
	fi
}

# Screens.
#
display_update_portrait()
{
	echo ${EINK_UPDATE_DISPLAY_ORIENTATION} ${EINK_ORIENT_PORTRAIT} >${EINK_UPDATE_DISPLAY}
	update_screen_info
}

display_amazon_screen()
{
	# If it's not there already, get the display back into its portrait orientation.
	#
	display_update_portrait

	# Assume smaller screen size.
	#
	if ( is_Luigi_Platform ); then
	    amazon_screen=${EINK_AMAZON_SCREEN_S}
	else
	    amazon_screen=${EINK_AMAZON_SCREEN_T}
	fi
	
	case ${SCREEN_X_RES} in
	
		# Switch to larger size if necessary.
		#
		${EINK_SCREEN_X_RES_N})
			amazon_screen=${EINK_AMAZON_SCREEN_N}
			;;

	esac
	
	# Get the factory-reset picture onto the display as cleanly as possible by clearing
	# the screen first and then issuing a flashing update.
	#
	${EIPS} -c
	${EIPS} -f -g $amazon_screen
}

display_repair_screen()
{
	echo ${EINK_UPDATE_DISPLAY_SCREEN_SLEEP} ${EINK_REPAIR_SCREEN} >${EINK_UPDATE_DISPLAY}
}

display_lowbat_screen()
{
	if [ ! -f ${EINK_WAKE_FILE} ]; then
		echo ${EINK_UPDATE_DISPLAY_SCREEN_SLEEP} ${EINK_LOWBAT_SCREEN} >${EINK_UPDATE_DISPLAY}
		touch ${EINK_WAKE_FILE}
	fi
}

display_reboot_screen()
{
	echo ${EINK_UPDATE_DISPLAY_SCREEN_SLEEP} ${EINK_REBOOT_SCREEN} >${EINK_UPDATE_DISPLAY}
}

reboot_screen_asis()
{
	echo ${EINK_SET_REBOOT_BEHAVIOR} ${EINK_REBOOT_SCREEN_ASIS} >${EINK_UPDATE_DISPLAY}
}

display_logo_screen()
{
	# Note:	Even though the eInk Shim rotates all of the UI splash screens back to
	#		portrait, it saves and restores the orientation when doing so.  When
	#		we're putting up the logo screen, we're in a place in the boot process
	#		where we don't want the orientation going back to landscape if that's
	#		where it was before the logo screen is put up.
	#
	#		So, we explicitly get the display back to the portrait orientation
	#		BEFORE putting up the logo screen.
	#
	display_update_portrait
	
	echo ${EINK_UPDATE_DISPLAY_SCREEN} ${EINK_BOOT_SCREEN} >${EINK_UPDATE_DISPLAY}
	reset_progressbar
}

display_update_screen_initial()
{
	update_rcs_info
	
	# Don't put up the initial software-update screen if it's already up because we don't
	# want the progress bar going backwards.
	#
	if [ ${SOFTWARE_UPDATE} -eq 0 ]; then
		display_update_portrait
		
		echo ${EINK_UPDATE_DISPLAY_SCREEN} ${EINK_UPDATE_SCREEN_INITIAL} >${EINK_UPDATE_DISPLAY}
	fi
}

display_update_screen_success()
{
	echo ${EINK_UPDATE_DISPLAY_SCREEN} ${EINK_UPDATE_SCREEN_SUCCESS} >${EINK_UPDATE_DISPLAY}
}

display_update_screen_failure()
{
	echo ${EINK_UPDATE_DISPLAY_SCREEN} ${EINK_UPDATE_SCREEN_FAILURE} >${EINK_UPDATE_DISPLAY}
}

display_update_screen_failure_no_wait()
{
	echo ${EINK_UPDATE_DISPLAY_SCREEN} ${EINK_UPDATE_SCREEN_FAILURE_NO_WAIT} >${EINK_UPDATE_DISPLAY}
}

update_progressbar()
{
	if [ -f ${EINK_PROGRESSBAR_CTRL} ]; then
		let progress=`cat ${EINK_PROGRESSBAR_CTRL}`
		
		# Only let the progressbar go up, and not passed 100%.
		#
		if [ $1 -ge $progress ] && [ $1 -le 100 ]; then
			let progress=$1
		
			echo $progress >${EINK_PROGRESSBAR_CTRL}
		fi
	fi
}

clear_progressbar()
{
	if [ -f ${EINK_PROGRESSBAR_CTRL} ]; then
		echo ${EINK_CLEAR_PROGRESSBAR} >${EINK_PROGRESSBAR_CTRL}
	fi
}

reset_progressbar()
{
	let progress_count=0
	let progress=0
	
	set_progressbar_xy_to_default_location
	clear_progressbar
	
	echo $progress_count >${EINK_PROGRESSBAR_COUNT}	
	update_progressbar $progress
}

set_progressbar_xy_to_default_location()
{
	update_screen_info
	
	progressbar_y=${SCREEN_Y_RES}+1
	progressbar_x=0
	
	echo ${EINK_SET_PROGRESSBAR_XY} $progressbar_x $progressbar_y >${EINK_UPDATE_DISPLAY}
}

set_progressbar_xy()
{
	progressbar_y=$1
	progressbar_x=0
	
	echo ${EINK_SET_PROGRESSBAR_XY} $progressbar_x $progressbar_y >${EINK_UPDATE_DISPLAY}
}

sleep_screen()
{
	if [ -c ${SCREEN} ]; then
