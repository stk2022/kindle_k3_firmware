# Misc.
#
msg()
{
	{ [ "x$3" != "x" ] && str_id="$3:" ; } || str_id="def:"
	{ [ "x$2" != "x" ] && msg_level="$2" ; } || msg_level="C" 
	msg_sub=`basename $0`
	eval msg_sllvl=\${MSG_SLLVL_$msg_level}
	eval msg_slnum=\${MSG_SLNUM_$msg_level}
	{ [ -e $MSG_CUR_LVL ] && curLvl=`cat $MSG_CUR_LVL` ; } || curLvl=1
	if [ $msg_slnum -ge $curLvl ]; then
		/usr/bin/logger -p local4.$msg_sllvl -t "system" "$msg_level $msg_sub:$str_id$1"
	fi
	[ "x$msg_level" != "xD" ] && echo "system: $msg_level $msg_sub:$str_id$1"
}

msg_setlevel()
{
	eval msg_slnum=\${MSG_SLNUM_$1}
	echo $msg_slnum > $MSG_CUR_LVL
}

ltpmsg()
{
	test_case_name=`basename $0 .sh`
	error="no"
	{ [ "x$1" != "x" ] && instance_num="$1" ; } || error="yes"
	case $instance_num in 
		*[^0-9]*) 
			error="yes"
			;; 
		*) 
			# It is an integer; all is well
		;; 
	esac 
	if [ "x$2" == "xPASS" ] || [ "x$2" == "xFAIL" ] || [ "x$2" == "xBROK" ] || [ "x$2" == "xWARN" ] || [ "x$2" == "xRETR" ] || [ "x$2" == "xINFO" ] || [ "x$2" == "xCONF" ]; then
			status_type="$2"
		else
			error="yes"
		fi
	{ [ "x$3" != "x" ] && message="$3" ; } || error="yes"

	if [ "$error" = "yes" ]; then
		echo "$test_case_name 1 BROK : test attempted to send a non-LTP-compliant message; source shell script needs to be fixed"
	else
		echo "$test_case_name $instance_num $status_type : $message"
	fi
}

ltpperf() 
{ 
    if [ "x$2" == "x" ]; then 
        ltpmsg $1 "BROK" "missing performance test name" 
    elif [ "x$3" == "x" ]; then 
        ltpmsg $1 "BROK" "missing unit" 
    elif [ "x$4" == "x" ]; then 
        ltpmsg $1 "BROK" "missing value" 
    else 
        ltpmsg $1 "INFO" "PERF: $2($3) $4" 
    fi 
}


read_nor()
{
	dd if=/dev/mtd/2 bs=1 count=$2 skip=$1 2>/dev/null
}

mntroot_rw()
{
	if [ -x ${KDB} ]; then
		MNTROOT_RW=`kdb get system/driver/filesystem/CMD_MOUNTRW`
		eval ${MNTROOT_RW}
	fi
}

mntroot_ro()
{
	# Defer switching the rootfs to read-only to the end of the start-up/shut-down sequences.
	#
	update_rcs_info

	if [ -x ${KDB} ] && [ ${SYSTEM_STARTUP} -eq 0 ] && [ ${SYSTEM_SHUTDOWN} -eq 0 ]; then
		MNTROOT_RO=`kdb get system/driver/filesystem/CMD_MOUNTRO`
		eval ${MNTROOT_RO}
	fi
}

boot_milestone()
{
	# The boot milestones require a 4-character string.  So, don't do anything
	# unless we at least get a string at all.
	#
	if [ $# -ne 0 ] && [ -n "$1" ]; then
		
		# Pad the milestone string with trailing 0's if we get one that's smaller
		# than 4 characters.
		#
		milestone="${1}0000"
		milestone="`printf "%.4s" $milestone`"
		
		echo -n "$milestone" >${BOOT_MILESTONE}
	fi
}

start_powerd()
{
	/etc/init.d/powerd start
	
	# Wait up to 30 seconds for powerd to go into its
	# active state.
	#
	_ACTIVE_RETRIES=30
	_COUNT=0
	
	while [ ${_COUNT} -lt ${_ACTIVE_RETRIES} ]; do

		sleep 1
		
		if ( is_PowerD_Active ); then
			return
		fi
		
		_COUNT=`expr ${_COUNT} + 1`
		
	done
}

stop_powerd()
{
	/etc/init.d/powerd stop
}

stop_all()
{
	${PMON} stop all
}

stop_browserd()
{
	if [ -f ${BROWSERD} ]; then
		browserd=`basename ${BROWSERD}`
		killall -KILL $browserd 2>/dev/null
	fi
}

