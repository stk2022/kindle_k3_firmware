#########################
### Memory size related stuff
memorysize()
{	
case "$_MS" in
	A) echo "128MB Manuf A";return $TRUE;;
	B) echo "256MB Manuf A";return $TRUE;;
	*) echo $undef;return $FALSE;;
esac
}

has_128MB() {
if [ "x$_MS" == "xA" ]; then
	return $TRUE 
fi
if [ "x$_MS" == "xB" ]; then 
	return $TRUE 
fi
return $FALSE
}

has_256MB() {
if [ "x$_MS" == "xB" ]; then
	return $TRUE
else 
	return $FALSE
fi
}

# Return memory as reported by /proc/meminfo
get_mem_total() {
    grep MemTotal /proc/meminfo | awk '{print $2}'
}

#########################
### Board specific stuff
is_Luigi3() {
	if ( is_Luigi ) && ( is_rev3 ); then return $TRUE; else return $FALSE; fi 
}

has_Ethernet() {
	if ( is_ADS ) || ( is_Mario ) || ( is_Luigi3 ); then return $TRUE; else return $FALSE; fi
}

has_WAN()
{
    # This isn't correct for some of the older boards, I think, but covers all the actual products.
    if is_Shasta_WFO; then
        return $FALSE
    else
        return $TRUE
    fi
}
