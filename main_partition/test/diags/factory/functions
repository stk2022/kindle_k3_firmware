######################################################################
# Function:     process_running
# Purpose:      Determine if a process whose name contains the passed
#               in string is running or not.
# Parameters:   String - process name
# Returns:      0 - Process not running
#               1 - Process running
# Assumptions:  Search finds existence of string, but if string is a
#               subset of another string, it will trigger a false
#               find.  In other words, a call like "process_running s"
#               would most likely return 1 because many processes contain
#               the character s.
#
#               Thus, this call's behavior needs to be checked in the 
#               context of how and where you're using it.
# Side Effect:  none
######################################################################
process_running()
{
    process_name="$1"
    proc_list=`ps aux` > /dev/null 2>&1
    NOT_FOUND=`echo "$proc_list" | grep "$process_name"`
    if [ -z "$NOT_FOUND" ]; then
        return 0
    else
        return 1
    fi
}


######################################################################
# Function:     wait_for_process_start
# Purpose:      Wait for given process to start running
# Parameters:   name - name of procedure in ps table to wait for 
#                   completion on
# Returns:      none
######################################################################
wait_for_process_start()
{
    _PROC_NAME="$1"

    #
    # Wait for process to start...
    #
    PLAYING=0
    while [ $PLAYING -eq 0 ]; do
        process_running "$_PROC_NAME" > /dev/null 2>&1
        RETVAL=$?
        if [ $RETVAL -eq 1 ]; then
            PLAYING=1
        fi
    done
}


######################################################################
# Function:     wait_for_process_stop
# Purpose:      Wait for given process to stop running
# Parameters:   name - name of procedure in ps table to wait for 
#                   completion on
# Returns:      none
######################################################################
wait_for_process_stop()
{
    _PROC_NAME="$1"

    #
    # Wait for process to finish...
    #
    PLAYING=1
    while [ $PLAYING -eq 1 ]; do
        process_running "$_PROC_NAME" > /dev/null 2>&1
        RETVAL=$?
        if [ $RETVAL -eq 0 ]; then
            PLAYING=0
        fi
    done
}



