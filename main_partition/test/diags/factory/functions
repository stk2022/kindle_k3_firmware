#
# Timer utilities
#
export SYSTEM_DIAGS_TIMER_RUNNING=0
export SYSTEM_DIAGS_TIMER_START=0
export SYSTEM_DIAGS_TIMER_END=0

######################################################################
# Function:     get_time
# Purpose:      Get the current time.  We use uptime as a relative
#               time so that we're not vulnerable to time changes.
# Parameters:   none
# Returns:      int - the relative time in seconds
######################################################################
get_time()
{
    # Return value in seconds
    cur_time=`cat /proc/uptime | sed -e 's/\.[0-9]* .*//'`
    return $cur_time
}



######################################################################
# Function:     disable_diag_timer
# Purpose:      Disable the diagnostic timer
# Parameters:   none
# Returns:      none
######################################################################
disable_diag_timer()
{
    SYSTEM_DIAGS_TIMER_RUNNING=0
}


######################################################################
# Function:     enable_diag_timer
# Purpose:      Enable the diagnostic timer (set flag indicating it's
#               running).
# Parameters:   none
# Returns:      none
######################################################################
enable_diag_timer()
{
    SYSTEM_DIAGS_TIMER_RUNNING=1
}


######################################################################
# Function:     diag_timer_in_use
# Purpose:      Return if the timer is currently running or not.
# Parameters:   none
# Returns:      0 - Timer not running
#               1 - Timer currently running
######################################################################
diag_timer_in_use()
{
    return $SYSTEM_DIAGS_TIMER_RUNNING
}


######################################################################
# Function:     get_timer_run_time
# Purpose:      Return the amount of time that the timer has been
#               running (in seconds)
# Parameters:   none
# Returns:      time (in seconds) since the timer was started.
######################################################################
get_timer_run_time()
{
    get_time
    cur_time="$?"
    return `expr $cur_time - $SYSTEM_DIAGS_TIMER_START`
}


######################################################################
# Function:     get_timer_start
# Purpose:      Get the time when the timer was started.
# Parameters:   none
# Returns:      time (in seconds) when timer was started
######################################################################
get_timer_start()
{
    return ${SYSTEM_DIAGS_TIMER_START}
}


######################################################################
# Function:     set_timeout
# Purpose:      Start the timer by setting our timer start and end times
# Parameters:   timeout - value in seconds before timer timeout occurs
# Returns:      0 - Timer was set 
#               1 - Timer was in use, TIMEOUT NOT SET
# Assumptions:  Both the return value from get_time and the user-passed
#               timeout value are of the same timebase (seconds in this case).
######################################################################
set_timeout()
{
    # Timer must be disabled first...
    diag_timer_in_use
    in_use=$?
    if [ $in_use -eq 0 ]; then
        enable_diag_timer
        get_time
        SYSTEM_DIAGS_TIMER_START=$?
        SYSTEM_DIAGS_TIMER_END=`expr $SYSTEM_DIAGS_TIMER_START + $1`
        return 0
    else
        echo "set_timeout() saw timer in use..."
        return 1
    fi
}



######################################################################
# Function:     check_timeout
# Purpose:      Read the timer and determine if we've timed out yet
# Parameters:   none
# Returns:      0 - timer's timeout was reached
#               non-zero - seconds left before timeout
######################################################################
check_timeout()
{
    get_time
    cur_time=$?
    if [ $SYSTEM_DIAGS_TIMER_RUNNING -eq 1 ] && \
       [ $SYSTEM_DIAGS_TIMER_END -le $cur_time ]; then
        return 0
    else
        time_left=`expr $SYSTEM_DIAGS_TIMER_END - $cur_time`
        return $time_left
    fi
}


