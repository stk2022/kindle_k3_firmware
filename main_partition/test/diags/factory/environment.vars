######################################################################

# Important Locations on Target
export DIAG_SUPPORT_ROOT="$DIAGNOSTIC_ROOT/tests"
export _DIAG_FUNCTIONS="$DIAGNOSTIC_ROOT/functions"


# Logfiles
export DIAG_LOG_ROOT_NAME="diagnostic_logs"
export DIAG_LOG_ROOT="/mnt/us/$DIAG_LOG_ROOT_NAME"
export OPERATOR_TEST_SUITE_LOGFILE_NAME="suite_results"
export DIAGNOSTIC_LOGFILE_NAME="diag_results"
export DIAGNOSTIC_CONSOLE_LOGFILE_NAME="diag_console.txt"
export DIAGNOSTIC_LOGFILE="/var/log/$DIAGNOSTIC_LOGFILE_NAME"
export DIAGNOSTIC_CONSOLE_LOGFILE="$DIAG_LOG_ROOT/$DIAGNOSTIC_CONSOLE_LOGFILE_NAME"
export SAVED_DIAGNOSTIC_LOGFILE="$DIAG_LOG_ROOT/$DIAGNOSTIC_LOGFILE_NAME"
export SAVED_OPERATOR_DIAGNOSTIC_LOGFILE="$DIAG_LOG_ROOT/$OPERATOR_TEST_SUITE_LOGFILE_NAME"
export TMP_DIAG_LOGFILE="/var/log/diags_tmp"
export DEVICE_INFORMATION_LOGFILE="$DIAG_LOG_ROOT/device_info.txt"
export WAN_INFORMATION_LOGFILE="$DIAG_LOG_ROOT/wan_info"
export EINK_WAVEFORM_ROOTFS_LOCATION="/opt/eink/images"

# Audio debug logfiles
export REG_DUMP_CODEC_LOGFILE="$DIAG_LOG_ROOT/audio_codec_dump.txt"
export LEFT_HP_CODEC_LOGFILE="$DIAG_LOG_ROOT/left_hp_codec_dump.txt"
export RIGHT_HP_CODEC_LOGFILE="$DIAG_LOG_ROOT/right_hp_codec_dump.txt"
export STEREO_HP_CODEC_LOGFILE="$DIAG_LOG_ROOT/stereo_hp_codec_dump.txt"
export LEFT_SPEAKER_CODEC_LOGFILE="$DIAG_LOG_ROOT/left_speaker_codec_dump.txt"
export RIGHT_SPEAKER_CODEC_LOGFILE="$DIAG_LOG_ROOT/right_speaker_codec_dump.txt"
export STEREO_SPEAKER_CODEC_LOGFILE="$DIAG_LOG_ROOT/stereo_speaker_codec_dump.txt"
export ALL_SPEAKER_CODEC_LOGFILE="$DIAG_LOG_ROOT/automated_codec_dump.txt"

# to setup the RTC to wakeup after a certain amount of time.
# it is now used in SSP test to put the device to sleep mode and wake up later,
# replacing the current method of shorting the TM99 in to ground to wakeup the 
# device.
# NOTE: if the RTC is implemented differently in other platforms,
# then move the RTC to the platform specific environment files
export RTC_ROOT="/sys/devices/platform/mxc_rtc.0"
export RTC_WAKEUP_ENABLE_ENTRY="${RTC_ROOT}/wakeup_enable"

# sys entry for accessory port
export ACCESSORY_PORT_ENTRY="/sys/devices/system/mx35_accessory/mx35_accessory0/mx35_accessory_state"

# sys entry for battery 
export BATTERY_LMD_ENTRY="/sys/devices/system/luigi_battery/luigi_battery0/battery_mAH"

# Flag file should diagnostic process abort for some reason
export _DIAG_PROCESS_ABORTED_FILENAME="diag_proc_aborted"
export DIAGNOSTIC_PROC_ABORTED_FILE="${DIAG_LOG_ROOT}/${_DIAG_PROCESS_ABORTED_FILENAME}"


# Commands / Utility Macros / Programs
export DOUT="serial_eips"

#
# Run-in Test Duration Time (2 hours in seconds)
#
export RUN_IN_DURATION_TIME=7200


#
# Individual Diagnostic Test Locations
#
export SYSTEM_DIAGNOSTICS_BIN="$DIAGNOSTIC_ROOT/system_diags.sh"
export AUDIO_ROOT="$DIAG_SUPPORT_ROOT/audio"
export AUDIO_HAL_ROOT="$AUDIO_ROOT/hal"
export AUDIO_SND_FILES_ROOT="$AUDIO_ROOT/sound_files"
export BUTTON_ROOT="$DIAG_SUPPORT_ROOT/button"
export BUTTON_HAL_ROOT="$BUTTON_ROOT/hal"
export FIVEWAY_ROOT="$DIAG_SUPPORT_ROOT/fiveway"
export FIVEWAY_HAL_ROOT="$FIVEWAY_ROOT/hal"
export GAS_GAUGE_ROOT="$DIAG_SUPPORT_ROOT/gas_gauge"
export GAS_GAUGE_HAL_ROOT="$GAS_GAUGE_ROOT/hal"
export KEYBOARD_ROOT="$DIAG_SUPPORT_ROOT/keyboard"
export KEYBOARD_HAL_ROOT="$KEYBOARD_ROOT/hal"
export DEV_SETTINGS_ROOT="$DIAG_SUPPORT_ROOT/dev_settings"
export DEV_SETTINGS_HAL_ROOT="$DEV_SETTINGS_ROOT/hal"
export LED_ROOT="$DIAG_SUPPORT_ROOT/led"
export LED_HAL_ROOT="$LED_ROOT/hal"
export POWER_ROOT="$DIAG_SUPPORT_ROOT/power"
export POWER_HAL_ROOT="$POWER_ROOT/hal"
export USB_DEVICE_ROOT="$DIAG_SUPPORT_ROOT/usb_device"
export USB_HAL_ROOT="$USB_DEVICE_ROOT/hal"
export VIDEO_ROOT="$DIAG_SUPPORT_ROOT/video"
export VIDEO_IMAGES_ROOT="$VIDEO_ROOT/$VIDEO_IMAGES_ROOT_OFFSET"
export VIDEO_HAL_ROOT="$VIDEO_ROOT/hal"
export WAN_ROOT="$DIAG_SUPPORT_ROOT/wan"
export WAN_HAL_ROOT="$WAN_ROOT/hal"
export WIFI_ROOT="$DIAG_SUPPORT_ROOT/wifi"
export WIFI_HAL_ROOT="$WIFI_ROOT/hal"
export CERT_ROOT="$DIAG_SUPPORT_ROOT/certification"
export CERT_HAL_ROOT="$CERT_ROOT/hal"
export RUN_MODES_ROOT="$DIAG_SUPPORT_ROOT/run_modes"
export RUN_MODES_HAL_ROOT="$RUN_MODES_ROOT/hal"
export MOVINAND_ROOT="$DIAG_SUPPORT_ROOT/moviNand"
export MOVINAND_HAL_ROOT="$MOVINAND_ROOT/hal"
export ACCEL_ROOT="$DIAG_SUPPORT_ROOT/accelerometer"
export ACCEL_IMAGES_ROOT="$ACCEL_ROOT/images"
export ACCEL_HAL_ROOT="$ACCEL_ROOT/hal"
export FCT_ROOT="$DIAG_SUPPORT_ROOT/fct"
export FCT_HAL_ROOT="$FCT_ROOT/hal"


#
# Component HAL Functions
#
export _VIDEO_HAL_FUNCTIONS="$VIDEO_HAL_ROOT/video.functions.$PRODUCT"
export _WAN_HAL_FUNCTIONS="$WAN_HAL_ROOT/wan.functions.$PRODUCT"
export _WIFI_HAL_FUNCTIONS="$WIFI_HAL_ROOT/wifi.functions.$PRODUCT"
export _AUDIO_HAL_FUNCTIONS="$AUDIO_HAL_ROOT/audio.functions.$PRODUCT"
export _BUTTON_HAL_FUNCTIONS="$BUTTON_HAL_ROOT/button.functions.$PRODUCT"
export _FIVEWAY_HAL_FUNCTIONS="$FIVEWAY_HAL_ROOT/fiveway.functions.$PRODUCT"
export _GAS_GAUGE_HAL_FUNCTIONS="$GAS_GAUGE_HAL_ROOT/gas_gauge.functions.$PRODUCT"
export _KEYBOARD_HAL_FUNCTIONS="$KEYBOARD_HAL_ROOT/keyboard.functions.$PRODUCT"
export _LED_HAL_FUNCTIONS="$LED_HAL_ROOT/led.functions.$PRODUCT"
export _DEV_SETTINGS_HAL_FUNCTIONS="$DEV_SETTINGS_HAL_ROOT/dev_settings.functions.$PRODUCT"
export _MOVINAND_HAL_FUNCTIONS="$MOVINAND_HAL_ROOT/moviNand.functions.$PRODUCT"
export _POWER_HAL_FUNCTIONS="$POWER_HAL_ROOT/power.functions.$PRODUCT"
export _USB_HAL_FUNCTIONS="$USB_HAL_ROOT/usb.functions.$PRODUCT"
export _RUN_MODES_HAL_FUNCTIONS="$RUN_MODES_HAL_ROOT/run_modes.functions.$PRODUCT"
export _CERT_HAL_FUNCTIONS="$CERT_HAL_ROOT/certification.functions.$PRODUCT"
export _ACCEL_HAL_FUNCTIONS="$ACCEL_HAL_ROOT/accel.functions.$PRODUCT"
export _FCT_HAL_FUNCTIONS="$FCT_HAL_ROOT/fct.functions.$PRODUCT"

# Default HAL locations - If a specific hal doesn't exist for a product, we will use the
# default HAL defined here instead (saves files in filesystem from softlinks)
export _DFLT_VIDEO_HAL_FUNCTIONS="$VIDEO_HAL_ROOT/video.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_WAN_HAL_FUNCTIONS="$WAN_HAL_ROOT/wan.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_WIFI_HAL_FUNCTIONS="$WIFI_HAL_ROOT/wifi.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_AUDIO_HAL_FUNCTIONS="$AUDIO_HAL_ROOT/audio.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_BUTTON_HAL_FUNCTIONS="$BUTTON_HAL_ROOT/button.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_FIVEWAY_HAL_FUNCTIONS="$FIVEWAY_HAL_ROOT/fiveway.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_GAS_GAUGE_HAL_FUNCTIONS="$GAS_GAUGE_HAL_ROOT/gas_gauge.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_KEYBOARD_HAL_FUNCTIONS="$KEYBOARD_HAL_ROOT/keyboard.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_LED_HAL_FUNCTIONS="$LED_HAL_ROOT/led.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_DEV_SETTINGS_HAL_FUNCTIONS="$DEV_SETTINGS_HAL_ROOT/dev_settings.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_MOVINAND_HAL_FUNCTIONS="$MOVINAND_HAL_ROOT/moviNand.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_POWER_HAL_FUNCTIONS="$POWER_HAL_ROOT/power.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_USB_HAL_FUNCTIONS="$USB_HAL_ROOT/usb.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_RUN_MODES_HAL_FUNCTIONS="$RUN_MODES_HAL_ROOT/run_modes.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_ACCEL_HAL_FUNCTIONS="$ACCEL_HAL_ROOT/accel.functions.$DEFAULT_BASE_SUFFIX"
export _DFLT_FCT_HAL_FUNCTIONS="$FCT_HAL_ROOT/fct.functions.$DEFAULT_BASE_SUFFIX"


# Auto-mode "do once" Execution Macros
export CYCLE_RUN_AUDIO="$DIAG_SUPPORT_ROOT/audio/audio_diag.sh cycle"
export CYCLE_STOP_AUDIO="$DIAG_SUPPORT_ROOT/audio/audio_diag.sh cycle_stop"
export CYCLE_RUN_USB_DEVICE="$DIAG_SUPPORT_ROOT/usb_device/usb_device_diag.sh cycle"
export CYCLE_STOP_USB_DEVICE="$DIAG_SUPPORT_ROOT/usb_device/usb_device_diag.sh cycle_stop"


# Auto-mode Execution Macros
export CYCLE_RUN_VIDEO="$VIDEO_ROOT/video_diag.sh cycle"
export CYCLE_RUN_5WAY="$FIVEWAY_ROOT/fiveway_diag.sh cycle"
export CYCLE_RUN_LED="$LED_ROOT/led_diag.sh cycle"
export CYCLE_RUN_KEYBOARD="$KEYBOARD_ROOT/keyboard_diag.sh cycle"
export CYCLE_RUN_BUTTON="$BUTTON_ROOT/button_diag.sh cycle"
export CYCLE_RUN_POWER="$POWER_ROOT/power_diag.sh cycle"
export CYCLE_RUN_WAN="$WAN_ROOT/wan_diag.sh cycle"
export CYCLE_RUN_WIFI="$WIFI_ROOT/wifi_diag.sh cycle"
export CYCLE_RUN_GAS_GAUGE="$GAS_GAUGE_ROOT/gas_gauge_diag.sh cycle"
export CYCLE_RUN_MODES="$RUN_MODES_ROOT/run_modes.sh cycle"
export CYCLE_RUN_MOVINAND="$MOVINAND_ROOT/moviNand_diag.sh cycle"

# Jump directly into full audio suite test
RUN_AUDIO_FULL_SUITE="$AUDIO_ROOT/audio_diag.sh suite"

# Operator-driven mode Execution Macros
RUN_AUDIO="$AUDIO_ROOT/audio_diag.sh start"
RUN_VIDEO="$VIDEO_ROOT/video_diag.sh start"
RUN_5WAY="$FIVEWAY_ROOT/fiveway_diag.sh start"
RUN_LED="$LED_ROOT/led_diag.sh start"
RUN_USB_DEVICE="$USB_DEVICE_ROOT/usb_device_diag.sh start"
RUN_KEYBOARD="$KEYBOARD_ROOT/keyboard_diag.sh start"
RUN_BUTTON="$BUTTON_ROOT/button_diag.sh start"
RUN_POWER="$POWER_ROOT/power_diag.sh start"
RUN_WAN="$WAN_ROOT/wan_diag.sh start"
RUN_WIFI="$WIFI_ROOT/wifi_diag.sh start"
RUN_GAS_GAUGE="$GAS_GAUGE_ROOT/gas_gauge_diag.sh start"
RUN_MOVINAND="$MOVINAND_ROOT/moviNand_diag.sh start"
RUN_MODES="$RUN_MODES_ROOT/run_modes.sh start"
RUN_CERT="$CERT_ROOT/cert_tests.sh start"
RUN_DEVICE_SETTINGS="$DEV_SETTINGS_ROOT/dev_settings.sh start"
RUN_ACCELEROMETER="$ACCEL_ROOT/accel_diag.sh start"
RUN_FCT="$FCT_ROOT/fct_diag.sh start"

# Constants for controlling success and failure screens
export SHOW_SUCCESS_DIALOGS=1
export BYPASS_SUCCESS_DIALOGS=0


#
# Useful Macros - FIX - not HAL compliant (will work for now because NELL == TURING)
#
export GET_KEYBOARD_INPUT="$DIAG_TOOL_ROOT/getkbdserial $KEYBOARD_DRIVER"
export GET_KEYBOARD_ONLY_INPUT="$DIAG_TOOL_ROOT/pnr"
export GET_BUTTON_INPUT="$DIAG_TOOL_ROOT/getkbdserial $BUTTON_DRIVER"
export GET_FIVEWAY_INPUT="$DIAG_TOOL_ROOT/getkbdserial $FIVEWAY_DRIVER"
export GET_KBD_FIVEWAY_INPUT="$DIAG_TOOL_ROOT/getskf $KEYBOARD_DRIVER $FIVEWAY_DRIVER"
export GET_VOLUME_BUTTON_INPUT="$DIAG_TOOL_ROOT/getkbdserial $VOLUME_BUTTON_DRIVER"

if [ -n "$HAS_VOLUME_BUTTON_DRIVER" ] && [ $HAS_VOLUME_BUTTON_DRIVER -eq 1 ]; then
    # If volume buttons come through separate driver, point to it via this macro
    export GET_KBD_VOLUME_BUTTON_INPUT="$DIAG_TOOL_ROOT/getskf $KEYBOARD_DRIVER $VOLUME_BUTTON_DRIVER"
else
    # Volume buttons don't come through separate driver, so they come through the keyboard driver,
    # meaning we only need to look at the keyboard driver
    export GET_KBD_VOLUME_BUTTON_INPUT="$DIAG_TOOL_ROOT/getkbdserial $KEYBOARD_DRIVER"
fi


#
# Enabling/Disabling auto-launch feature
#
#
AUTO_RUN_DISABLE_FILENAME="disable_sys_diags"
export AUTO_RUN_DISABLE_DIAGS_FILE="$DIAGNOSTIC_ROOT/$AUTO_RUN_DISABLE_FILENAME"
