#############################################################################

#
# Shasta WiFi Only Supported Component List
#
export HAS_VIDEO=1
export HAS_LED=1
export HAS_BUTTONS=1
export HAS_KEYBOARD=1
export HAS_FIVEWAY=1
export HAS_USB_DEVICE=1
export HAS_POWER=1
export HAS_GAS_GAUGE=1
export HAS_AUDIO=1
export USE_AUDIO_SERVER=0
export HAS_WAN=0
export HAS_MOVINAND=1
export HAS_RUN_MODES=1
export HAS_RUN_IN=1
export HAS_DEVICE_SETTINGS=1
export HAS_FCT=1
export HAS_TTS=1
export HAS_WIFI=1
export HAS_OPERATOR_SUITE=1
export HAS_MAC_ADDRESS=$HAS_WIFI
export HAS_SETABLE_PANEL_ID=0
export HAS_DISPLAY_VCOM=1
export HAS_VOLUME_BUTTON_DRIVER=1
export HAS_ACCESSORY_PORT=1
export HAS_MICROPHONE=1
export HAS_DEDICATED_NUMBER_KEYS=0

export HAS_PREDEFINED_INPUT_ENTRIES=1
export BUTTON_DRIVER="/dev/input/event0"
export KEYBOARD_DRIVER="/dev/input/event0"
export FIVEWAY_DRIVER="/dev/input/event1"

if [ "x$HAS_VOLUME_BUTTON_DRIVER" == "x1" ]; then
    export VOLUME_BUTTON_DRIVER="/dev/input/event2"
fi
if [ "x$HAS_USB_SERIAL_SUPPORT" == "x1" ]; then
    export SERIAL_USB_DRIVER="/dev/$SERIAL_USB_DRIVER_NAME"
fi

#
# Debug Menus
#
export HAS_AUDIO_DEBUG=0
export HAS_UPDATE_DIAGS_MENU=0
export HAS_MANUFACTURER_CODE_VERIFY=1

#
# Allow TPH sleep current test to retry on failure
#
export ENABLE_TPH_VERIFY_RETRY=1

#
# Has check to verify battery part number
#
export HAS_VERIFY_BATTERY_PART_NUMBER=1

#
# Acceptable part number list
#
export BATTERY_PART_NUMBER_LIST=`kdb get system/driver/charger/SYS_BATT_IDS_VALID`
# Set to 1 to require DS Blooming support in waveforms
export HAS_DS_BLOOMING=1

# Shasta Wifi Only EVT2 does not support MIC test yet.
export FCT_MIC_TEST_ENABLED=0


# Since headset detection works for audio test, but not for FCT test
# it is disabled for now.
export FCT_HEADPHONE_DETECTION=0



# Input devices / Event entry
export WFO_KEYBOARD_DRIVER_NAME="mxckpd"
export WFO_FIVEWAY_DRIVER_NAME="fiveway"
export WFO_VNC_DRIVER_NAME="vncinput"
export WFO_VOLUME_BUTTON_DRIVER_NAME="volume"
export WFO_BUTTON_DRIVER_NAME="$WFO_KEYBOARD_DRIVER_NAME"

export KEYBOARD_DRIVER_NAME=$WFO_KEYBOARD_DRIVER_NAME
export BUTTON_DRIVER_NAME=$WFO_BUTTON_DRIVER_NAME
export FIVEWAY_DRIVER_NAME=$WFO_FIVEWAY_DRIVER_NAME
export VNC_DRIVER_NAME=$WFO_VNC_DRIVER_NAME
export VOLUME_BUTTON_DRIVER_NAME=$WFO_VOLUME_BUTTON_DRIVER_NAME

# Screen file printing utility
export FILE_TO_SCREEN="file_to_screen"
export LOGFILE_TO_SCREEN="$FILE_TO_SCREEN $DIAGNOSTIC_LOGFILE"

# Video Images Directory
export VIDEO_IMAGES_ROOT_OFFSET="images/A"
export VIDEO_IMAGES_ROOT="$VIDEO_ROOT/$VIDEO_IMAGES_ROOT_OFFSET"


# ART Directory
export WIFI_ART_BASE="art/art/bin"

export WIFI_ROOT="${DIAGNOSTIC_ROOT}/tests/wifi"
export ART_ROOT="${WIFI_ROOT}/${WIFI_ART_BASE}"

# Key code definitions
export KEY_1=2
export KEY_2=3
export KEY_3=4
export KEY_4=5
export KEY_5=6
export KEY_6=7
export KEY_7=8
export KEY_8=9
export KEY_9=10
export KEY_0=11
export KEY_Q=16
export KEY_W=17
export KEY_E=18
export KEY_R=19
export KEY_T=20
export KEY_Y=21
export KEY_U=22
export KEY_I=23
export KEY_O=24
export KEY_P=25
export KEY_A=30
export KEY_S=31
export KEY_D=32
export KEY_F=33
export KEY_G=34
export KEY_H=35
export KEY_J=36
export KEY_K=37
export KEY_L=38
export KEY_BACKSPACE=14
export KEY_Z=44
export KEY_X=45
export KEY_C=46
export KEY_V=47
export KEY_B=48
export KEY_N=49
export KEY_M=50
export KEY_DOT=52
export KEY_SLASH=53
export KEY_ENTER=28
export KEY_SHIFT=42
export KEY_ALT=56
export KEY_SPACE=57
export KEY_FONT=190
export KEY_SYM=126
export KEY_123=125


# Success and Failure Keys
export SUCCESS_KEY=$KEY_Q
export FAILURE_KEY=$KEY_P
export EXIT_KEY=$KEY_X
export EXIT_KEY_LABEL='X'
export ALTERNATE_EXIT_KEY=$KEY_C
export ALTERNATE_EXIT_KEY_LABEL='C'
export SUCCESS_KEY_LABEL='Q'
export FAILURE_KEY_LABEL='P'

#
# Define menu item constants
#
export MENU_ITEM_1=$KEY_Q
export MENU_ITEM_2=$KEY_W
export MENU_ITEM_3=$KEY_E
export MENU_ITEM_4=$KEY_R
export MENU_ITEM_5=$KEY_T
export MENU_ITEM_6=$KEY_Y
export MENU_ITEM_7=$KEY_U
export MENU_ITEM_8=$KEY_I
export MENU_ITEM_9=$KEY_O
export MENU_ITEM_10=$KEY_P
export MENU_ITEM_11=$KEY_M
export MENU_ITEM_12=$KEY_N
export MENU_ITEM_13=$KEY_A
export MENU_ITEM_14=$KEY_S
export MENU_ITEM_15=$KEY_F
export MENU_ITEM_16=$KEY_G
export MENU_ITEM_17=$KEY_H
export MENU_ITEM_18=$KEY_J
export MENU_ITEM_19=$KEY_K
export MENU_ITEM_20=$KEY_L
export MENU_ITEM_DISABLE=$KEY_D


#
# Define a list of the possible menu items
#
export MENU_ITEM_LIST="$MENU_ITEM_1 $MENU_ITEM_2 $MENU_ITEM_3 $MENU_ITEM_4 $MENU_ITEM_5 $MENU_ITEM_6 $MENU_ITEM_7 $MENU_ITEM_8 $MENU_ITEM_9 $MENU_ITEM_10 $MENU_ITEM_11 $MENU_ITEM_12 $MENU_ITEM_13 $MENU_ITEM_14 $MENU_ITEM_15 $MENU_ITEM_16 $MENU_ITEM_17 $MENU_ITEM_18 $MENU_ITEM_19 $MENU_ITEM_20"

#
# Define components to be exercised in run-in test
#
export RUN_IN_USB_ENABLE_DEFAULT="DISABLED";
export RUN_IN_WIFI_ENABLE_DEFAULT="ENABLED";
export RUN_IN_WAN_ENABLE_DEFAULT="ENABLED";
export RUN_IN_VIDEO_ENABLE_DEFAULT="ENABLED";
export RUN_IN_HAPTIC_ENABLE_DEFAULT="ENABLED";
export RUN_IN_LED_ENABLE_DEFAULT="ENABLED";
export RUN_IN_AUDIO_ENABLE_DEFAULT="DISABLED";
export RUN_IN_POWER_ENABLE_DEFAULT="ENABLED";
export RUN_IN_GAS_GAUGE_ENABLE_DEFAULT="ENABLED";
export RUN_IN_MOVINAND_ENABLE_DEFAULT="ENABLED";
export RUN_IN_CHARGER_CHECK_ENABLE_DEFAULT="ENABLED";

#
# Define default parameters for run-in tests
#
export RUN_IN_HP_AUDIO_VOLUME=10
export RUN_IN_SPEAKER_AUDIO_VOLUME=10
export ATLAS_TEST_AUDIO_VOLUME=56

#
# volume scaling - on scale 0-100, 7 clicks per db change
#
export VOLUME_PER_STEP=7


#
# Default battery charge level to target during run-in (35 - 75%)
#
# Per Charles' spec, confirm final charge state prior to 
#   shipment (35% < charge < 75%)
# Test uses >= and <= (i.e. limits below are VALID final capacities
#
export LOW_CHARGE_LIMIT=37
export HIGH_CHARGE_LIMIT=73
export RUN_IN_LOWER_CHARGE_LIMIT=35
export RUN_IN_UPPER_CHARGE_LIMIT=75


#
# No screen offsets required on Shasta WiFi Only as it has smaller (standard) screen
#
export SCREEN_X_OFFSET=0
export SCREEN_Y_OFFSET=0

#
# Tools and locations to use for setting device parameters
#
export PANEL_SET_TOOL="/usr/sbin/idme --panel"
export SERIAL_NUMBER_SET_TOOL="/usr/sbin/idme --serial"
export PCB_ID_SET_TOOL="/usr/sbin/idme --pcbsn"
export DO_SET_MANUF_CODE_CMD="/usr/sbin/idme --mfg"
export DO_FLASH_WAVEFORM_CMD="/usr/sbin/idme --wave"
export DEVICE_PCB_ID_FILE="$DIAGNOSTIC_ROOT/device_pcb_id"
export DEVICE_PCB_ID_ENTRY="/proc/pcbsn"
export DEVICE_SERIAL_NUMBER_ENTRY="/proc/usid"
export VIDEO_SYS_DIR="/sys/devices/platform/eink_fb.0"
export DEVICE_PANEL_ID_ENTRY="$VIDEO_SYS_DIR/panel_bcd"
export VIDEO_VCOM_SETTING_ENTRY="$VIDEO_SYS_DIR/vcom"
export LOBATH_ENTRY="/sys/devices/platform/fsl-usb2-udc/charger_lobath_unsub"

