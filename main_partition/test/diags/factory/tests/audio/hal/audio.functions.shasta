}


######################################################################
# Function:     get_hp_balance
# Purpose:      Return the currently set audio headphone channel 
#               balance on the device
# Paramters:    none
# Returns:      none
# Side Effect:  Echo's the balance
######################################################################
get_hp_balance()
{
    echo "$AUDIO_BALANCE_SET"
}


######################################################################
# Function:    mute
# Purpose:     Mute the device.
# Paramters:   none
# Returns:     none
# Assumptions: Setting each output channel volume to 0 will mute device
# Side Effect: device is muted
#               Sets PRE_MUTE_HP_VOLUME and PRE_MUTE_SPEAKER_VOLUME
#               variables....
######################################################################
mute()
{
    if [ "$MUTE" -eq 0 ]; then
        export MUTE=1
        set_hp_volume "$MUTE_AUDIO"
        set_speaker_volume "$MUTE_AUDIO"
    fi
}


######################################################################
# Function:    unmute
# Purpose:     Unmute the device.
# Paramters:   none
# Returns:     none
# Side Effect: device is unmuted
######################################################################
unmute()
{
    if [ "$MUTE" -eq 1 ]; then
        # Set volume to user-defined level
        set_hp_volume "$AUDIO_VOLUME"
        set_speaker_volume "$AUDIO_VOLUME"
        export MUTE=0
    fi
}


######################################################################
# Function:     stop_atlas_sound_loop_tool
# Purpose:      Stop the playAtlasSoundTool from running
# Paramters:    none
# Returns:      none
######################################################################
stop_atlas_sound_loop_tool()
{
    if [ $ATLAS_SOUND_PID -ne 0 ]; then
        echo "Killing process having PID of $ATLAS_SOUND_PID"
        kill -9 $ATLAS_SOUND_PID
        export ATLAS_SOUND_PID=0
    fi
}


######################################################################
# Function:     start_atlas_sound_loop_tool
# Purpose:      Start the playAtlasSoundTool running in background,
#               store off it's PID in ATLAS_SOUND_PID
# Paramters:    none
# Returns:      none
######################################################################
start_atlas_sound_loop_tool()
{
    "$DIAG_TOOL_ROOT"/playAtlasTestSound $vol $chan_enabled & > /dev/null 2>&1
    if [ $? ]; then
        export ATLAS_SOUND_PID=$!
    fi
}


######################################################################
# Function:     audio_start_atlas_sound
# Purpose:      Starts playing an audio file in the background.
# Paramters:    enabled_channels - channel(s) to enable; one of:
#                   CHANNEL_NONE
#                   CHANNEL_ALL
#                   CHANNEL_HP_LEFT
#                   CHANNEL_HP_RIGHT
#                   CHANNEL_HP_STEREO
#                   CHANNEL_SPEAKER_LEFT
#                   CHANNEL_SPEAKER_RIGHT
#                   CHANNEL_SPEAKER_STEREO
#                   CHANNEL_ALL_SPEAKER
#               volume - value between 0 and 100
# Returns:      none
# Side Effect:  Starts playing sound in background
######################################################################
audio_start_atlas_sound()
{
    chan_enabled="$1"
    vol="$2"

    # If user didn't pass channel, set it to a default (headphones)
    if [ -z "$chan_enabled" ]; then
        chan_enabled=$CHANNEL_HP_STEREO
    fi

    # If user didn't pass volume, set it to a default
    if [ -z "$vol" ]; then
        vol=$ATLAS_TEST_AUDIO_VOLUME
    fi

    #
    # Run aplayd script so we get continuous sound
    #
    start_atlas_sound_loop_tool

    #
    # Wait for sound to start...
    #
    wait_for_process_start "$PCM_TOOL_NAME"
}
    


######################################################################
# Function:     audio_stop_atlas_sound
# Purpose:      Stops the audio file that's playing in the background.
# Paramters:    none
# Returns:      none
# Side Effect:  kills all audio play tool processes
######################################################################
audio_stop_atlas_sound()
{
    # Kill the play script
    stop_atlas_sound_loop_tool

    # Kill the background player process.
    killall -9 "$_AUDIO_TOOL_USED" > /dev/null 2>&1

    #
    # Wait for sound to stop...
    #
    wait_for_process_stop "$_AUDIO_TOOL_USED"
}
    
######################################################################
# Function:     audio_start_sound
# Purpose:      Starts playing an audio file in the background.
# Paramters:    enabled_channels - channel(s) to enable; one of:
#                   CHANNEL_NONE
#                   CHANNEL_ALL
#                   CHANNEL_HP_LEFT
#                   CHANNEL_HP_RIGHT
#                   CHANNEL_HP_STEREO
#                   CHANNEL_SPEAKER_LEFT
#                   CHANNEL_SPEAKER_RIGHT
#                   CHANNEL_SPEAKER_STEREO
#                   CHANNEL_ALL_SPEAKER
#               volume - value between 0 and 100
# Returns:      none
# Side Effect:  Starts playing sound in background
######################################################################
audio_start_sound()
{
    chan_enabled="$1"
    vol="$2"

    # If user didn't pass channel, set it to a default (all on)
    if [ -z "$chan_enabled" ]; then
        chan_enabled=$CHANNEL_ALL
        echo "audio_start_sound() enabling default chan_enabled = $chan_enabled"
    fi

    # If user didn't pass volume, set it to a default
    if [ -z "$vol" ]; then
        vol=$DEFAULT_VOLUME
        echo "audio_start_sound() enabling default volume $vol"
    fi

    # Determine which tool we're using, then start sound playing...
    # Run aplayd script so we get continuous sound
    case "$chan_enabled" in
        $CHANNEL_ALL_SPEAKER)
            export _AUDIO_TOOL_USED="$AUDIO_TOOL_NAME"
            ${RUN_PLAY_TOOL} $vol $chan_enabled & 2>&1
            wait_for_process_start "$_AUDIO_TOOL_USED"
            write_reg 24 0x24
            ;;
        *)
            export _AUDIO_TOOL_USED="$PCM_TOOL_NAME"
            ${PCM_TOOL} -c2 > /dev/null 2>&1 &
            wait_for_process_start "$_AUDIO_TOOL_USED"
            audio_set_parms $chan_enabled $vol
            ;;
    esac
}


######################################################################
# Function:     audio_stop_sound
# Purpose:      Stops the audio file that's playing in the background.
# Paramters:    none
# Returns:      none
# Side Effect:  kills all audio play tool processes
######################################################################
audio_stop_sound()
{
    # Mute the volume
    audio_set_parms $CHANNEL_NONE $MUTE_AUDIO

    # Kill the play script
    ${RUN_KILL_PLAY_TOOL} > /dev/null 2>&1

    # Kill the background player process.
    killall "$_AUDIO_TOOL_USED" > /dev/null 2>&1

    #
    # Wait for sound to stop...
    #
    wait_for_process_stop "$_AUDIO_TOOL_USED"
}
    

######################################################################
# Function:     audio_hp_detect
# Purpose:      Determine if the headphones are inserted or not
# Paramters:    none
# Returns:      HEADPHONES_NOT_DETECTED - headphones are not inserted
#               HEADPHONES_DETECTED - headphones have been detected
# Assumptions:  If the file /sys/devices/platform/mxc_ALSA/hsconnect
#               exists, a headset is connected.  If not, no headset.
######################################################################
audio_hp_detect()
{
    vmsg "audio_hp_detect()"
    export HP_DETECT_STAT=`eval cat /sys/devices/system/headset_status/headset_status0/headset_status`
    if [ $HP_DETECT_STAT -eq 0 ]; then
        return $HEADPHONES_DETECTED
    else
    	return $HEADPHONES_NOT_DETECTED
    fi
}


######################################################################
# Function:     audio_wait_hp_detect
# Purpose:      Wait until we detect that the headphones have been
#               inserted before continuing.
#               To-Do : Allows user to exit if HP detection isn't working
#
#               In the case of the user clearing the screen, we return
#               that the headphones are in the direction the caller was
#               waiting on, but will cause sub-test failure for hp
#               detection to get reported.
# Paramters:    direction - which event to look for:
#                   "in" - wait for headphones to be inserted
#                   "out" - wait for headphones to be removed
# Returns:      HEADPHONES_NOT_DETECTED - headphones are not inserted
#               HEADPHONES_DETECTED - headphones have been detected
######################################################################
audio_wait_hp_detect()
{
    vmsg "audio_wait_hp_detect($1)"
    hp_direction=$1
    case "$hp_direction" in
        in|IN)
            audio_hp_detect
            status="$?"
            if [ $status -eq $HEADPHONES_NOT_DETECTED ]; then
                wait_count=0
                DONE=0
                while [ $DONE -eq 0 ]; do
                    sleep 1
                    audio_hp_detect
                    status="$?"
                    if [ $status -eq $HEADPHONES_DETECTED ]; then
                        DONE=1
                    else
                        let wait_count+=1
                        if [ $wait_count -gt $HP_DETECT_TIMEOUT ]; then
                            DONE=1
                        fi
                    fi
                done
            fi
            ;;
        out|OUT)
            audio_hp_detect
            status="$?"
            if [ $status -eq $HEADPHONES_DETECTED ]; then
                wait_count=0
                DONE=0
                while [ $DONE -eq 0 ]; do
                    sleep 1
                    audio_hp_detect
                    status=$?
                    if [ $status -eq $HEADPHONES_NOT_DETECTED ]; then
                        DONE=1
                    else
                        let wait_count+=1
                        if [ $wait_count -gt $HP_DETECT_TIMEOUT ]; then
                            DONE=1
                        fi
                    fi
                done
            fi
            ;;
        *)
            echo "ERROR - bad value $hp_direction passed to audio_wait_hp_detect"
            status=$HEADPHONES_NOT_DETECTED
            ;;
    esac

    return $status
}


######################################################################
# Function:     audio_fct_wait_hp_detect
# Purpose:      Wait until we detect that the headphones have been
#               inserted OR we reach our maximum wait timeout.
#
#               This routine is designed for use by the FCT test
#
# Paramters:    direction - which event to look for:
#                   "in" - wait for headphones to be inserted
#                   "out" - wait for headphones to be removed
# Returns:      0 - Saw the headphone event
#               1 - Timed out waiting for event - no event seen 
#               2 - direction not supported
######################################################################
audio_fct_wait_hp_detect()
{
    vmsg "audio_wait_hp_detect_or_timeout($1, $2)"
    hp_direction=$1
    case "$hp_direction" in
        in|IN)
            hp_dir_status=$HEADPHONES_DETECTED;
            ;;
        out|OUT)
            hp_dir_status=$HEADPHONES_NOT_DETECTED;
            ;;
        *)
            echo "ERROR - bad value $hp_direction passed to audio_fct_wait_hp_detect"
            return 2
            ;;
    esac

    hp_wait_count=0
    while [ 1 ]; do
        # Check status
        audio_hp_detect
        status="$?"
        if [ $status -eq $hp_dir_status ]; then
            return 0
        fi
        # If we waited long enough, time out and fail now...
        if [ $hp_wait_count -ge $FCT_HP_WAIT_TIMEOUT ]; then
            failure "FCT Headphone $hp_direction Detection"
            return 1
        fi

        # Not ready yet, poor-man sleep for a 1/10 second and recheck...
        KEY=`$GET_KEYBOARD_INPUT 100`

        # Indicate we waited another 1/10 of a second
        let hp_wait_count+=1
    done
}


######################################################################
# Function:    do_run_mode_audio
# Purpose:     Play an audio tone until the user says stop.
# Paramters:   channels - constant representing channels to enable.
#              volume - volume to run test at.
# Returns:     none
######################################################################
do_run_mode_audio()
{
    LOCAL_CHANNELS_ENABLED="$1"
    LOCAL_SPEAKER_AUDIO_VOLUME="$2"

    # Enable the speakers, start playing a sound at max volume
    THE_CURRENT_VOLUME=$LOCAL_SPEAKER_AUDIO_VOLUME
    audio_start_sound $LOCAL_CHANNELS_ENABLED $LOCAL_SPEAKER_AUDIO_VOLUME

    clear_screen
    ${DOUT} -n 17 4 "Audio Run Mode"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"

    # Force loop to draw the rest of the screen
    REDRAW=1

    #
    # Get the key request
    #
    DONE=0
    while [ $DONE -ne 1 ]; do
        if [ $REDRAW -eq 1 ]; then
            erase_line 9
            ${DOUT} -n 4 7 "Audio is enabled and currently playing at"
            ${DOUT} -n 4 9 "$THE_CURRENT_VOLUME percent of maximum volume."
            ${DOUT} -n 4 11 "Use the volume buttons to adjust volume."
            ${DOUT} 5 15 "Press $EXIT_KEY_LABEL to return to run mode menu..."
            REDRAW=0
        fi

        KEY=`$GET_KEYBOARD_INPUT`
        case "$KEY" in
            $VOLUME_UP)
                if [ $THE_CURRENT_VOLUME -lt $MAX_VOLUME ]; then
                    let THE_CURRENT_VOLUME+=1
                    set_speaker_volume $THE_CURRENT_VOLUME
                    REDRAW=1
                fi
                ;;

            $VOLUME_DOWN)
                if [ $THE_CURRENT_VOLUME -gt $MIN_VOLUME ]; then
                    let THE_CURRENT_VOLUME-=1
                    set_speaker_volume $THE_CURRENT_VOLUME
                    REDRAW=1
                fi
                ;;

            $EXIT_KEY)
                DONE=1
                ;;

            *)
                REDRAW=1
                ;;
        esac
    done;

    # Shut the audio off - must be pretty annoying at this point
    audio_stop_sound
    disable_speakers
}


setAtlasClock()
{
    "$DIAG_TOOL_ROOT/pmic" write 41 $1 > /dev/null 2>&1
}


overclockAtlas()
{
    "$DIAG_TOOL_ROOT"/pmic wor 41 9 7 3 > /dev/null 2>&1
}


restoreAtlasClock()
{
    "$DIAG_TOOL_ROOT"/pmic write 41 $ORIG_ATLAS_CLOCK > /dev/null 2>&1
}


getAtlasClock()
{
    VAL=`${READ_ATLAS_CLOCK}`
    let CLOCK_VAL=`echo "$VAL" | grep "result =" | \
        sed -e 's/result = \(0x[0-9A-F]*\) : [01]* [01]* [01]* [01]* [01]*/\1/g'`
    echo "$CLOCK_VAL"
}

run_atlas_test()
{
    # Get sound playing
    audio_start_atlas_sound

    # Let user know what's going on
    clear_screen
    banner="Atlas Chip Verification"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 8 5 "$base"
    ${DOUT} -n 5 7 "A sound should be playing now."
    ${DOUT} -n 5 9 "Once the test has been started, you will"
    ${DOUT} -n 5 11 "hear the tone change."
    ${DOUT} -n 5 15 "IF it becomes noise, indicate FAIL."
    ${DOUT} -n 5 17 "IF tone gets higher but is still audible,"
    ${DOUT} -n 5 19 "indicate PASS."
    ${DOUT} -n 5 23 "Press the $SUCCESS_KEY_LABEL now to start the test"
    ${DOUT} 5 25 "Press the $EXIT_KEY_LABEL to cancel the test"
    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        case "$KEY" in
            $SUCCESS_KEY)
                DONE=1
                ;;
            $EXIT_KEY)
                audio_stop_atlas_sound
                return 2
                ;;
            *)
                ;;
        esac
    done

    # User indicated ready to start test

    # Grab original Value
    export ORIG_ATLAS_CLOCK=`getAtlasClock`

    # Overclock the Atlas chip
    overclockAtlas

    # Ask user if audio is OK or not
    clear_screen
    ${DOUT} -n 5 7 "A sound should be playing now."
    ${DOUT} -n 5 11 "Press $FAILURE_KEY_LABEL if the sound is noise (FAIL)"
    ${DOUT} 5 13 "Press $SUCCESS_KEY_LABEL if tone is higher, but ok (PASS)"
    _done=0
    _local_fail=0
    while [ $_done -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        case "$KEY" in
            $SUCCESS_KEY)
                success "Atlas Chip Verified OK"
                _done=1
                ;;
            $FAILURE_KEY)
                failure "Atlas Chip Found To Be BAD"
                _local_fail=1
                _done=1
                ;;
            *)
                #ECHO_VAL=`getAtlasClock`
                #printf "Read Atlas register as 0x%x\n" $ECHO_VAL
                ;;
        esac
    done

    # User indicated pass/fail, stop sound from playing
    audio_stop_atlas_sound

    # Restore the Atlas clock to normal
    restoreAtlasClock

    # Return failure status
    return $_local_fail
}


display_tts_start_error()
{
    # Let user know what's going on
    clear_screen
    banner="TTS Daemon Startup Error"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 8 5 "$base"
    center_text "ERROR" 8 "$base"
    ${DOUT} -n $? 7 "ERROR"
    ${DOUT} -n 8 9 "The TTS daemon failed to start up."
    ${DOUT} 8 13 "Press $EXIT_KEY_LABEL to exit test"
    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        case "$KEY" in
            $EXIT_KEY)
                DONE=1
                ;;
            *)
                ;;
        esac
    done
}


do_display_tts_text()
{
    # Put up the text we'll do TTS on...
    clear_screen
    $FILE_TO_SCREEN $TTS_TEST_FILE

    # Now put up the "Select X to cancel" banner across bottom....
    erase_line  38
    ${DOUT} 5 38 "Select $EXIT_KEY_LABEL to cancel test."
}

do_start_tts()
{
    # Start tts going, normal speed
    lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" URI tts:///var/tmp/ttsUSFifo
    _err=$?
    while [ $_err -ne 0 ]; do
        # Audioserver not ready yet...
        echo "Audioserver not ready (err=$_err), sleeping 1..."
        sleep 1
        lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" URI tts:///var/tmp/ttsUSFifo
        _err=$?
    done
    lipc-set-prop "$TTS_DBUS_ENTRYPOINT" TtsISpeed 100
    lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" Control 1
    cat "${TTS_TEST_FILE}" > "${TTS_FIFO}"
	
    # Now launch tool to keep fifo fed for continuous playback
    $FEED_TTS_TOOL "$TTS_TEST_FILE" "$TTS_FIFO" &
	
    # or use this if you need "read once and stop" behavior
    #cat "$TTS_TEST_FILE" > "$TTS_FIFO"
}

do_pause_tts()
{
    lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" Control 2
}


do_stop_tts()
{
    # Stop the fifo feed tool
    $KILL_FEED_TTS_TOOL
    wait_for_process_stop "$FEED_TTS_TOOL_NAME"

    # Stop the actual TTS engine
    lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" Control 3
}


do_start_audio_daemons()
{
    process_running "$AUDIO_DAEMON_NAME"
    if [ $? -eq 0 ]; then
        echo "Starting $AUDIO_DAEMON..."
        $AUDIO_DAEMON start > /dev/null 2>&1
        _DONE=0
        _timeout=0
        while [ $_DONE -eq 0 ]; do
            process_running "$AUDIO_DAEMON_NAME"
            _DONE=$?
            if [ $_DONE -eq 0 ]; then
                sleep 1
                let _timeout++
                if [ $_timeout -ge $AUDIO_DAEMON_STARTUP_TIMEOUT ]; then
                    echo "Timed out waiting for start of $AUDIO_DAEMON..."
                    return 1
                fi
            fi
        done
    fi

    # If tts daemon is not running, start it up now
    process_running "$TTS_DAEMON_NAME"
    if [ $? -eq 0 ]; then
        echo "Starting $TTS_DAEMON..."
        $TTS_DAEMON start > /dev/null 2>&1
        _DONE=0
        _timeout=0
        while [ $_DONE -eq 0 ]; do
            process_running "$TTS_DAEMON_NAME"
            _DONE=$?
            if [ $_DONE -eq 0 ]; then
                sleep 1
                let _timeout++
                if [ $_timeout -ge $TTS_DAEMON_STARTUP_TIMEOUT ]; then
                    echo "Timed out waiting for start of $TTS_DAEMON..."
                    return 1
                fi
            fi
        done
    fi
    return 0
}


do_run_tts_test()
{
    if ! [ -f "$TTS_TEST_FILE" ]; then
        echo "$TTS_TEST_FILE does not exist."
        return
    fi

    # Start up ttsd and audioServer
    do_start_audio_daemons
    if [ $? -ne 0 ]; then
        display_tts_start_error
        return
    fi

    # Tell user what's going on....
    do_display_tts_text

    # Get TTS going
    do_start_tts

    #
    # Wait for operator to cancel test
    #
    wait_for_key $EXIT_KEY

    # Stop TTS stream
    do_stop_tts
}


######################################################################
# Function:     audio_hal_init
# Purpose:      First verifies that the system support required to run
#               the audio diagnostic is present and working.  If it is,
#               this routine initializes sound system so that 
#               subsequent calls to these audio HAL primitives will work.
# Paramters:    none
# Returns:      0        - Success - Audio system initialized properly
#               Non-zero - Failure - System software support missing/broken
#                   Failure results include:
#                       1 - Audio Play tool is missing/broken
#                       6 - /sys entry for codec access is missing
# Side Effect:  Mutes volume and disables all channels
######################################################################
audio_hal_init()
{
    #
    # Verify system support / environment
    #
    verify_audio_system_support
    RETVAL=$?
    if [ $RETVAL -ne 0 ]; then
        vmsg "verifry_audio_system_support failed with error $RETVAL"
        return $RETVAL
    fi

    # Return success
    return 0
}


######################################################################
# Function:    audio_hal_exit
# Purpose:     De-initialize / cleanup sound system test
#               This routine will
#                   1) Disable all audio channels
#                   2) Mute the audio on the device
# Paramters:   none
# Returns:     none
# Side Effect: Channels are disabled, volume out is muted
######################################################################
audio_hal_exit()
{
    if [ $AUDIO_CHANNELS_INITED -eq 1 ]; then
        #   Disable sound channels, mute volume
        disable_channel $CHANNEL_ALL
        mute
        AUDIO_CHANNELS_INITED=0
    fi
} 

######################################################################
# Function:    do_mic_test
# Purpose:     Test the mic to head set audio bypass path
# Paramters:   none
#              
# Returns:     failure status
#              0: success
#              1: fail
######################################################################
do_mic_test()
{
    vmsg "Starting Mic test"

    clear_screen
    # remove the extra step to save test time 
#    ${DOUT} -n 5 7  "       Mic test"
#    ${DOUT} -n 5 9  "~~~~~~~~~~~~~~~~~~~~~~~~~"
#    ${DOUT} -n 5 11 "Insert head set to device"
#    ${DOUT}    5 13 "Hit $EXIT_KEY_LABEL when ready"

#    wait_for_key $EXIT_KEY

    # enable loopback (bypass) from analog input (mic) to analog output (head set)
    do_bypass_test

    # Ask user if mic is OK or not
    clear_screen
    ${DOUT} -n 5 7 "The microphone should be working now."
    ${DOUT} -n 5 11 "Press $SUCCESS_KEY_LABEL:"
    ${DOUT}    8 13 "(PASS) sound from mic to head set"
            
    ${DOUT} -n 5 15 "Press $FAILURE_KEY_LABEL:"
    ${DOUT}    8 17 "(FAIL) no sound from mic to head set"
    _done=0
    _local_fail=0
    while [ $_done -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        case "$KEY" in
            $SUCCESS_KEY)
                success "Mic Test Verified OK"
                _done=1
                ;;
            $FAILURE_KEY)
                failure "Mic Test FAILED"
                _local_fail=1
                _done=1
                ;;
            *)
                ;;
        esac
    done

    # turn off audio after test
    do_audio_off

    # Return failure status
    return $_local_fail

}

# first arg: register number
#
read_reg()
{
    echo -n $1 > /sys/devices/system/wm8960_reg/wm8960_reg0/wm8960_reg
    cat /sys/devices/system/wm8960_register/wm8960_register0/wm8960_register
}

# first arg: register number
# second arg: value
# returns:  0 - success
#           non-zero - failure verifying audio system support (missing codec entry)
write_reg()
{
    verify_audio_system_support
    RETVAL=$?
    if [ $RETVAL -ne 0 ]; then
        failure "verify_audio_system_support failed with error $RETVAL"
        return $RETVAL
    fi

    echo -n $1 > $AUDIO_REGISTER_SELECT_ENTRY
    echo -n $2 > $AUDIO_REGISTER_SET_ENTRY
    return 0
}
                

# by pass                          
do_bypass_test()
{                    
    write_reg 0  0x11F  # R0  (00h)  Left input volume           
    write_reg 1  0x11F  # R1  (01h)  Right input volume          
    write_reg 2  0x17F  # R2  (02h)  LOUT1 volume                
    write_reg 3  0x17F  # R3  (03h)  ROUT1 volume                
    write_reg 6  0x00   # R6  (06h)  ADC & DAC Control (CTR2)     

    write_reg 24 0x64   # R24 (18h)  Additional control(2) Headset
    write_reg 25 0xFF   # R25 (19h)  Pwr Mgmt (1)                 
    write_reg 26 0x1FA  # R26 (1Ah)  Pwr Mgmt (2)                 
    write_reg 28 0x04   # R28 (1Ch)  Anti-pop 1                   
    write_reg 29 0x00   # R29 (1Dh)  Anti-pop 2                   
    write_reg 32 0x138  # R32 (20h)  ADCL signal path             
    write_reg 33 0x108  # R33 (21h)  ADCR signal path             
    write_reg 45 0x80   # R45 (2Dh)  Bypass (1)                   
    write_reg 46 0x80   # R46 (2Eh)  Bypass (2)                   
    write_reg 47 0x3C   # R47 (2Fh)  Pwr Mgmt (3)                 
    write_reg 48 0x3B   # R48 (30h)  Additional Control (4)       
    write_reg 49 0x37   # R49 (31h)  Class D Control (1)          

     
}

do_read_codec_regs()
{
    process_running "pcm"
    if [ $? -eq 1 ]; then
        do_local_echo "PCM is running"
    else
        do_local_echo "PCM is not running"
    fi

    # common regs
    read_reg 0          # R0  (00h)  Left input volume"
    read_reg 1          # R1  (01h)  Right input volume"
    read_reg 2          # R2  (02h)  LOUT1 volume                
    read_reg 3          # R3  (03h)  ROUT1 volume                
    read_reg 4          # R4  (04h)  Clocking (1)                 
    read_reg 5          # R5  (05h)  ADC & DAC Control (CTR1)     
    read_reg 6          # R6  (06h)  ADC & DAC Control (CTR2)
    read_reg 7          # R7  (07h)  Audio Interface                
    read_reg 8          # R8  (08h)  Clocking (2)                 
    read_reg 9          # R9  (09h)  Audio Interface              
    read_reg 10         # R10 (0Ah)  Left DAC volume              
    read_reg 11         # R11 (0Bh)  Right DAC volume             
    read_reg 16         # R16 (10h)  3D Control                   
    read_reg 17         # R17 (11h)  ALC1                         
    read_reg 18         # R18 (12h)  ALC2                         
    read_reg 19         # R19 (13h)  ALC3                         
    read_reg 20         # R20 (14h)  Noise Gate                   
    read_reg 21         # R21 (15h)  Left ADC volume              
    read_reg 22         # R22 (16h)  Right ADC volume             
    read_reg 23         # R23 (17h)  Additional control(1)        
    read_reg 24         # R24 (18h)  Additional control(2) Headset
    read_reg 25         # R25 (19h)  Pwr Mgmt (1)
    read_reg 26         # R26 (1Ah)  Pwr Mgmt (2)
    read_reg 27         # R27 (1Bh)  Additional control(3)        
    read_reg 28         # R28 (1Ch)  Anti-pop 1
    read_reg 29         # R29 (1Dh)  Anti-pop 2
    read_reg 32         # R32 (20h)  ADCL signal path
    read_reg 33         # R33 (21h)  ADCR signal path
    read_reg 34         # R34 (22h)  Left out Mix (1)             
    read_reg 37         # R37 (25h)  Right out Mix (2)            
    read_reg 38         # R38 (26h)  Mono out Mix (1)             
    read_reg 39         # R39 (27h)  Mono out Mix (2)             
    read_reg 40         # R40 (28h)  LOUT2 volume                 
    read_reg 41         # R41 (29h)  ROUT2 volume                 
    read_reg 42         # R42 (2Ah)  MONOOUT volume               
    read_reg 43         # R43 (2Bh)  Input Boost Mixer (1)        
    read_reg 44         # R44 (2Ch)  Input Boost Mixer (2)        
    read_reg 45         # R45 (2Dh)  Bypass (1)
    read_reg 46         # R46 (2Eh)  Bypass (2)
    read_reg 47         # R47 (2Fh)  Pwr Mgmt (3)
    read_reg 48         # R48 (30h)  Additional Control (4)
    read_reg 49         # R49 (31h)  Class D Control (1)
    read_reg 51         # R51 (33h)  Class D Control (3)          
    read_reg 52         # R52 (34h)  PLL N                        
    read_reg 53         # R53 (35h)  PLL K 1                      
    read_reg 54         # R54 (36h)  PLL K 2                      
    read_reg 55         # R55 (37h)  PLL K 3                      
}                                    

dump_codec_regs_to_file()
{
    _savefile="$1"
    do_local_echo "Dumping codec registers to $_savefile"
    do_read_codec_regs > $_savefile
}

do_audio_off()
{
    write_reg 26 0x00       # R26 (1Ah)  Pwr Mgmt (2)
    write_reg 47 0x00       # R47 (2Fh)  Pwr Mgmt (3)
    write_reg 28 0x01       # R28 (1Ch)  Anti-pop 1
    write_reg 49 0x37       # R49 (31h)  Class D Control (1)
    write_reg 48 0xB        # R48 (30h)  Additional Control (4)
    write_reg 25 0x100      # R25 (19h)  Pwr Mgmt (1)
    write_reg 0  0x170      # R0  (00h)  Left input volume"
    write_reg 1  0x170      # R1  (01h)  Right input volume"
    write_reg 2  $OUT1_MUTE # R2  (02h)  LOUT1 volume                
    write_reg 3  $OUT1_MUTE # R3  (03h)  ROUT1 volume                
    write_reg 10 0x100      # R10 (0Ah)  LDAC volume                
    write_reg 11 0x100      # R11 (0Bh)  RDAC volume                
    write_reg 6  0x08       # R6  (06h)  ADC & DAC Control (CTR2)
    write_reg 24 0x64       # R24 (18h)  Additional control(2) Headset
    write_reg 29 0x00       # R29 (1Dh)  Anti-pop 2
    write_reg 32 0x138      # R32 (20h)  ADCL signal path
    write_reg 33 0x100      # R33 (21h)  ADCR signal path
    write_reg 45 0x50       # R45 (2Dh)  Bypass (1)
    write_reg 46 0x50       # R46 (2Eh)  Bypass (2)
}                                    
            
do_playback_test()
{
    write_reg 0  0x170  # R0  (00h)  Left input volume"            
    write_reg 1  0x170  # R1  (01h)  Right input volume"           
    write_reg 2  0x17A  # R2  (02h)  LOUT1 volume                
    write_reg 3  0x17A  # R3  (03h)  ROUT1 volume                
    write_reg 6  0x08   # R6  (06h)  ADC & DAC Control (CTR2)      
    write_reg 24 0x64   # R24 (18h)  Additional control(2) Headset 
    write_reg 25 0xC0   # R25 (19h)  Pwr Mgmt (1)                  
    write_reg 26 0x1FB  # R26 (1Ah)  Pwr Mgmt (2)                  
    write_reg 28 0x04   # R28 (1Ch)  Anti-pop 1                    
    write_reg 29 0x00   # R29 (1Dh)  Anti-pop 2                    
    write_reg 32 0x138  # R32 (20h)  ADCL signal path              
    write_reg 33 0x100  # R33 (21h)  ADCR signal path              
    write_reg 45 0x50   # R45 (2Dh)  Bypass (1)                    
    write_reg 46 0x50   # R46 (2Eh)  Bypass (2)                    
    write_reg 47 0x0C   # R47 (2Fh)  Pwr Mgmt (3)                  
    write_reg 48 0x09   # R48 (30h)  Additional Control (4)        
    write_reg 49 0xF7   # R49 (31h)  Class D Control (1)           
}            


do_speaker_test()
{
    write_reg 0  0x170  # R0  (00h)  Left input volume"             
    write_reg 1  0x170  # R1  (01h)  Right input volume"            
    write_reg 2  0x17A  # R2  (02h)  LOUT1 volume                
    write_reg 3  0x17A  # R3  (03h)  ROUT1 volume                
    write_reg 6  0x08   # R6  (06h)  ADC & DAC Control (CTR2)       
    write_reg 24 0x24   # R24 (18h)  Additional control(2) Headset  
    write_reg 25 0xC0   # R25 (19h)  Pwr Mgmt (1)                   
    write_reg 26 0x1FA  # R26 (1Ah)  Pwr Mgmt (2)                   
    write_reg 28 0x04   # R28 (1Ch)  Anti-pop 1                     
    write_reg 29 0x00   # R29 (1Dh)  Anti-pop 2                     
    write_reg 32 0x138  # R32 (20h)  ADCL signal path               
    write_reg 33 0x100  # R33 (21h)  ADCR signal path               
    write_reg 45 0x50   # R45 (2Dh)  Bypass (1)                     
    write_reg 46 0x50   # R46 (2Eh)  Bypass (2)                     
    write_reg 47 0x0C   # R47 (2Fh)  Pwr Mgmt (3)                   
    write_reg 48 0x09   # R48 (30h)  Additional Control (4)         
    write_reg 49 0xF7   # R49 (31h)  Class D Control (1)            
}


if [ "x$_AUDIO_HAL_INCLUDED" == "x1" ]; then
    return 0
fi

# Player and Mixer execution macros
export PCM_TOOL_NAME="pcm"
export PCM_TOOL="/test/diags/factory/tools/$PCM_TOOL_NAME"
export RUN_PLAY_TOOL="$DIAG_TOOL_ROOT/playsound"
export RUN_KILL_PLAY_TOOL="killall -9 playsound"
export PLAY_TOOL="$PCM_TOOL"
export PLAY_TOOL_NAME="$PCM_TOOL_NAME"
#RUN_KILL_PLAY_TOOL="killall -9 $PLAY_TOOL_NAME"


# Current tool being used for audio
export _AUDIO_TOOL_USED="$PCM_TOOL_NAME"


export APLAY_TOOL_NAME="aplay"
export APLAY_TOOL="/usr/bin/$APLAY_TOOL_NAME"
export AUTOMATED_PLAY_TOOL_NAME="$APLAY_TOOL_NAME"

# Current player being used to play sound
export AUDIO_TOOL_NAME=$APLAY_TOOL_NAME

# Audio server support
AUDIO_SERVER_TOOL="/usr/bin/audioServer"
export AUDIO_DAEMON_NAME="audio"
export AUDIO_DAEMON="/etc/init.d/audio"
export AUDIO_DAEMON_STARTUP_TIMEOUT=20

# TTS Support
export TTS_TEST_FILE="$AUDIO_SND_FILES_ROOT/tts.txt"
export FEED_TTS_TOOL_NAME="shasta_tts.sh"
export TTS_DAEMON_NAME="ttsd"
export TTS_DAEMON="/etc/init.d/$TTS_DAEMON_NAME" 
export TTS_DAEMON_STARTUP_TIMEOUT=20
export FEED_TTS_TOOL="$DIAG_TOOL_ROOT/$FEED_TTS_TOOL_NAME"
export KILL_FEED_TTS_TOOL="killall -9 $FEED_TTS_TOOL_NAME"
export TTS_FIFO="/var/tmp/ttsUSFifo"

# Atlas Overclock Macro
export ORIG_ATLAS_CLOCK=0
READ_ATLAS_CLOCK="$DIAG_TOOL_ROOT/pmic read 41"
OVER_CLOCK_ATLAS="$DIAG_TOOL_ROOT/pmic wor 41 9 7 3"
RESTORE_ATLAS_CLOCK="$DIAG_TOOL_ROOT/pmic write 41 $ORIG_ATLAS_CLOCK"

# Special volume registers for balance volume
export _LL_VOLUME_MUTE=256

# We pick a value of 0x176 for the unmute because that's what the
# sound driver uses, and we don't want our volume multiplier to change when it
# (or we) adjust volume (sound driver may write register behind our back / vice-versa)
export OUT1_UNMUTE=0x176
export OUT1_MUTE=0x100 
export AUDIO_REGISTER_SELECT_ENTRY="/sys/devices/system/wm8960_reg/wm8960_reg0/wm8960_reg"
export AUDIO_REGISTER_SET_ENTRY="/sys/devices/system/wm8960_register/wm8960_register0/wm8960_register"

# Message to sync external audio test tool
export AUTOMATED_AUDIO_SYNC_MESSAGE="Starting audio sample for automated tester..."


# For storing PID of playAtlasSoundTool
export ATLAS_SOUND_PID=0

#
# Proc entry for enabling/disabling the speaker
#
# Shasta does not have audio support yet
SPEAKER_ENABLE_PROC_ENTRY="/proc/asound/PMICaudio/pcm0p/sub0/speaker"


#
# Constants for volume and balance setting
#
export  FULL_LEFT=100
export  FULL_RIGHT=0
export  EVEN_BALANCE=50
export  MAX_VOLUME=100
export  MIN_VOLUME=0
export  DEFAULT_VOLUME=90
export  MUTE_AUDIO=$MIN_VOLUME

#
# Sound channel constants for use as parameter when calling
#    enable_channel() and disable_channel()
#
export  CHANNEL_NONE=0
export  CHANNEL_ALL=1
export  CHANNEL_HP_LEFT=2
export  CHANNEL_HP_RIGHT=3
export  CHANNEL_HP_STEREO=4
export  CHANNEL_SPEAKER_LEFT=5
export  CHANNEL_SPEAKER_RIGHT=6
export  CHANNEL_SPEAKER_STEREO=7
export  CHANNEL_ALL_SPEAKER=8


#
# Return values from headphone detection routines
#
export HEADPHONES_DETECTED=1
export HEADPHONES_NOT_DETECTED=0

#
# Storage for pre-mute volume settings
#
export PRE_MUTE_HP_VOLUME=$MUTE_AUDIO
export PRE_MUTE_SPEAKER_VOLUME=$MUTE_AUDIO
export AUDIO_VOLUME=$MUTE_AUDIO
export DEFAULT_AUTOMATED_VOLUME_OUT="90"



#
# Codec values for enabling/disabling speakers
#
# DAC R/L Power up, 
# LOUT1 ROUT1 Output Buffers Power up, 
# SPKL & SPKR Power down
# OUT3 and PLL Enable Power up
#
export CODEC_SPEAKER_CNTL_REG=26 


#
# DACL, DACR, LOUT1, ROUT1, SPKL, SPKR, 0, OUT3, PLL_EN
#export CODEC_DISABLE_SPEAKERS=0xe3
export CODEC_DISABLE_SPEAKERS=0x1e3
export CODEC_ENABLE_SPEAKERS=0x1fb
export CODEC_ENABLE_LEFT_CHANNEL=0x153
export CODEC_ENABLE_RIGHT_CHANNEL=0x0ab


export LEFT_AUDIO_REG=10
export RIGHT_AUDIO_REG=11

export LEFT_SPEAKER_AUDIO_BALANCE_REG=40
export RIGHT_SPEAKER_AUDIO_BALANCE_REG=41
export LEFT_HP_AUDIO_BALANCE_REG=2
export RIGHT_HP_AUDIO_BALANCE_REG=3
export HP_BALANCE_FULL_VALUE=0x17a
export HP_BALANCE_NONE_VALUE=0x100
export SPEAKER_BALANCE_FULL_VALUE=0x1ff
export SPEAKER_BALANCE_NONE_VALUE=0x100

#
# possible error codes returned from audio_hal_init
#
export AUDIO_PLAY_TOOL_BROKEN=1
export AUDIO_MIX_TOOL_BROKEN=2
export AUDIO_BALANCE_TOOL_BROKEN=3
export AUDIO_VOLUME_TOOL_BROKEN=4
export AUDIO_SPEAKER_ENABLE_BROKEN=5
export AUDIO_ENTRY_FOR_CODEC_MISSING=6
export AUDIO_SERVER_MISSING=7 


#
#
#
export AUDIO_DBUS_ENTRYPOINT="com.lab126.audio"
export TTS_DBUS_ENTRYPOINT="com.lab126.tts"
 
#
# Indicates whether hal_init intialized the channels or not
#
export AUDIO_CHANNELS_INITED=0
export AUDIO_CHANNELS_ENABLED=$CHANNEL_NONE

#
# Maximum seconds to wait while looking for headphone insertion event
#
export HP_DETECT_TIMEOUT=15


#
# Wait up to 5 seconds for a headphone insert/remove event during FCT test
#   Time is in 1/10 of a second....
#
export FCT_HP_WAIT_TIMEOUT=50 

export _AUDIO_HAL_INCLUDED=1

