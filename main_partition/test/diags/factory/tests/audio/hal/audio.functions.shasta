######################################################################
get_hp_volume()
{
    get_volume_out
    #echo "$AUDIO_VOLUME"
}


######################################################################
# Function:     get_speaker_balance
# Purpose:      Return the currently set audio channel balance on the 
#               device
# Paramters:    none
# Returns:      none
# Side Effect:  Echo's the balance
######################################################################
get_speaker_balance()
{
