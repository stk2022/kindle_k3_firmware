######################################################################
#
#  File:   audio.functions.shasta
#
#  Author: Nick Vaccaro <nvaccaro@lab126.com>
#
#  Date:   02/19/08
#
#  Copyright (C) 2005-2010 Amazon Technologies
#
#  Description:
#      Shasta Architecture Sound HAL layer for diagnostic audio scripts.  
#   This file will define various HAL routines based on the utility used
#   for testing the audio system.
#
#   Balance and Volume Constants
#       FULL_LEFT                       - Left audio channel
#       FULL_RIGHT                      - Right audio channel
#       EVEN_BALANCE                    - Balance even on both right and left
#       MAX_VOLUME                      - Maximum volume supported on device
#       MIN_VOLUME                      - Minimum volume supported on device
#       DEFAULT_VOLUME                  - Default volume to use on device
#       MUTE_AUDIO                      - Mute the audio
#
#   Channel Constants
#       CHANNEL_NONE                    - No channels
#       CHANNEL_ALL                     - All channels (hp left/right, speakers left/right)
#       CHANNEL_HP_LEFT                 - Headphones Left Channel
#       CHANNEL_HP_RIGHT                - Headphones Right Channel
#       CHANNEL_HP_STEREO               - Both Headphone Channels
#       CHANNEL_SPEAKER_LEFT            - Left Speaker Channel
#       CHANNEL_SPEAKER_RIGHT           - Right Speaker Channel
#       CHANNEL_SPEAKER_STEREO          - Both Speaker Channels
#       CHANNEL_ALL_SPEAKER             - Both Speaker Channels (for automation)
#
#   Return Values from Headphone Detection Routines
#       HEADPHONES_DETECTED             - Headphones were detected (in)
#       HEADPHONES_NOT_DETECTED         - Headphones were not detected (out)
#
#   Error Codes from audio_hal_init()
#       AUDIO_PLAY_TOOL_BROKEN          - Audio play tool is missing or broken
#       AUDIO_MIX_TOOL_BROKEN           - Mixer tool is missing or broken
#       AUDIO_BALANCE_TOOL_BROKEN       - Audio balance mechanism is missing or broken
#       AUDIO_VOLUME_TOOL_BROKEN        - Audio volume mechanism is missing or broken
#       AUDIO_SPEAKER_ENABLE_BROKEN     - Speaker enable mechanism is missing or broken
#       AUDIO_ENTRY_FOR_CODEC_MISSING	- One of the /sys entry to access the codec is missing
#       AUDIO_SERVER_MISSING            - audioServer tool could not be found
#
#   Global Variables
#       AUDIO_CHANNELS_INITED           - 1 if channels have been initialized, 0 if not
#       AUDIO_CHANNELS_ENABLED          - 1 if channels enabled, 0 if not
#       
#   This file contains the following hal routines:
#       audio_set_channel_enable()      - Remember channel enable status
#       audio_get_channel_enabled()     - Return remembered channel enable status
#       audio_restore_channel_state()   - Restore channel status to last remembered
#       audio_set_parms()               - Set channel balance and volume
#       set_balance()                   - Set channel balance
#       set_speaker_balance()           - Set speaker channel balance
#       set_hp_balance()                - Set headphone channel balance
#       disable_speakers()              - Disable speakers
#       enable_speakers()               - Enable speakers
#       enable_headphones()             - Enable headphones
#       disable_headphones()            - Disable headphones
#       enable_channel()                - Enable a given channel
#       disable_channel()               - Disable a given channel
#       set_volume_in()                 - Set input volume (does nothing)
#       audio_set_volume_out()          - Sets the audio out volume variable
#       audio_get_volume_out()          - Returns the audio out volume variable
#       audio_restore_volume_out()      - Restores device volume to last remembered volume
#       set_volume_out()                - Sets device output volume
#       set_speaker_volume()            - Sets speaker volume to specified volume
#       set_hp_volume()                 - Sets headphone volume
#       verify_audio_system_support()   - Verifies all required audio features present
#       get_speaker_volume()            - Returns speaker volume from system
#       get_hp_volume()                 - Returns headphone volume from system
#       get_speaker_balance()           - Returns speaker balance from system
#       get_hp_balance()                - Returns headphone balance from system
#       mute()                          - Mute the system if not already muted
#       unmute()                        - Unmute the system if muted.
#       audio_start_sound()             - Start a sound playing
#       audio_stop_sound()              - Stop the sound from playing
#       audio_hp_detect()               - Determine if headphones are inserted or not
#       audio_wait_hp_detect()          - Wait for headphones to be inserted
#       audio_fct_wait_hp_detect()      - FCT routine to wait for headphone event or timeout
#       do_run_mode_audio()             - Sound run mode - Enable speakers & hp, start a sound
#       audio_hal_init()                - Audio hal initialization routine
#       audio_hal_exit()                - Audio hal cleanup exit routine
#
######################################################################

# Key Map Definition
[ -f ${_KEYBOARD_HAL_FUNCTIONS} ] && . ${_KEYBOARD_HAL_FUNCTIONS}

# Button Map Definition
[ -f ${_BUTTON_HAL_FUNCTIONS} ] && . ${_BUTTON_HAL_FUNCTIONS}

######################################################################
# Function:     audio_set_channel_enable
# Purpose:      Set a flag to indicate audio channel enable status
# Paramters:    enable status 
# Returns:      none
######################################################################
audio_set_channel_enable()
{
    export AUDIO_CHANNELS_ENABLED=$1
}

######################################################################
# Function:     audio_get_channel_enable
# Purpose:      Return the audio channel enable status
# Paramters:    none
# Returns:      audio channel enable status
######################################################################
audio_get_channel_enabled()
{
    return $AUDIO_CHANNELS_ENABLED
}

######################################################################
# Function:     audio_restore_channel_state
# Purpose:      Return the audio channel status to the last remembered
#               state.
# Paramters:    none
# Returns:      none
# Side Effects: Possibly enables or disables channels
######################################################################
audio_restore_channel_state()
{
    enable_channel $AUDIO_CHANNELS_ENABLED
}


######################################################################
# Function:    set_balance
# Purpose:     Set the Left/Right Speaker and HP Channel Balance
# Paramters:   leftValue - Value in percentage of balance for left channel
#                   (remainder from 100% is right channel balance value)
# Returns:     none
# Assumptions: Audio driver supports the Lipc Balance property
# Side Effect: Sets balance of both HP and Speakers on Shasta
######################################################################
set_balance()
{
    vmsg "set_balance"

    # Verify parameter is integer between 0 and 100
    balance=$1
    nonums="$(echo $balance |  sed 's/[0-9]//g')"
    if [ ! -z "$nonums" ] ; then
        echo "Balance percentage '$balance' must be an integer value."
        exit 0
    elif [ $balance -gt 100 ]; then
        echo "Balance percentage '$balance' must be integer between 0 and 100."
        exit 0
    fi

    # Set balance
    if [ -n "$USE_AUDIO_SERVER" ] && [ $USE_AUDIO_SERVER -eq 1 ]; then
        lipc-set-prop "$AUDIO_DBUS_ENTRYPOINT" "Balance" "$balance" > /dev/null 2>&1
    else
        export AUDIO_BALANCE_SET=$balance
        
        # On Shasta, we need to control the balance via the volume registers
        # Therefor, now that we've potentially changed the balance, we need to
        # activate that change my adjusting the volumes in the left and right channel
        # accordingly (i.e. if balance is 100% left, then mute right channel volume)
        _CUR_VOLUME=`get_volume_out`
        set_volume_out $_CUR_VOLUME
    fi
}



######################################################################
# Function:    set_speaker_balance
# Purpose:     Set the Left/Right Speaker Channel Balance
# Paramters:   leftValue - Value in percentage of balance for left channel
#                   (remainder from 100% is right channel balance value)
# Returns:     none
# Assumptions: Audio driver supports the Lipc Balance property
# Side Effect: Sets balance of both HP and Speakers on Shasta
######################################################################
set_speaker_balance()
{
    vmsg "set_speaker_balance"
    set_balance "$@"
}

######################################################################
# Function:    set_hp_balance
# Purpose:     Set the Left/Right Headphone Jack Channel Balance
# Paramters:   leftValue - Value in percentage of balance for left channel
#                   (remainder from 100% is right channel balance value)
# Returns:     none
# Assumptions: Audio driver supports the Lipc Balance property
# Side Effect: Sets balance of both HP and Speakers on Shasta
######################################################################
set_hp_balance()
{
    vmsg "set_hp_balance"
    set_balance "$@"
}


######################################################################
# Function:    disable_speakers
# Purpose:     Disable the speaker channels
# Paramters:   none
# Returns:     none
# Assumptions: Enabling/Disabling speakers is controlled by GPIO FIXME
######################################################################
disable_speakers()
{
    vmsg "disable_speakers"
    write_reg $CODEC_SPEAKER_CNTL_REG $CODEC_DISABLE_SPEAKERS
}


######################################################################
# Function:    enable_speakers
# Purpose:     Enable the speaker channels
# Paramters:   none
# Returns:     none
######################################################################
enable_speakers()
{
    vmsg "enable_speakers"
    write_reg $CODEC_SPEAKER_CNTL_REG $CODEC_ENABLE_SPEAKERS
}


######################################################################
# Function:    enable_headphones_left
# Purpose:     Enable the left headphone channel only
# Parameters:  none
# Returns:     none
######################################################################
enable_headphones_left()
{
    vmsg "enable_headphones_left"

    # Unmute the OUT1 volumes to allow headphones volume
    write_reg 2  $OUT1_UNMUTE   # R2  (02h)  LOUT1 volume
    write_reg 3  $OUT1_MUTE     # R3  (03h)  ROUT1 volume
}


######################################################################
# Function:    enable_headphones_right
# Purpose:     Enable the right headphone channel only
# Parameters:  none
# Returns:     none
######################################################################
enable_headphones_right()
{
    vmsg "enable_headphones_right"

    # Unmute the OUT1 volumes to allow headphones volume
    write_reg 2  $OUT1_MUTE     # R2  (02h)  LOUT1 volume
    write_reg 3  $OUT1_UNMUTE   # R3  (03h)  ROUT1 volume
}


######################################################################
# Function:    enable_headphones
# Purpose:     Enable the headphone channels
# Paramters:   none
# Returns:     none
# Assumptions: Device supports disabling/enabling of headphone channels
#               (Mario DOES NOT support disabling of headphones)
######################################################################
enable_headphones()
{
    vmsg "enable_headphones"

    # Unmute the OUT1 volumes to allow headphones volume
    write_reg 2  $OUT1_UNMUTE # R2  (02h)  LOUT1 volume
    write_reg 3  $OUT1_UNMUTE # R3  (03h)  ROUT1 volume
}


######################################################################
# Function:    disable_headphones
# Purpose:     Disable the headphone channels
# Paramters:   none
# Returns:     none
# Assumptions: Device supports disabling/enabling of headphone channels
#               (Mario DOES NOT support disabling of headphones)
######################################################################
disable_headphones()
{
    # Mario doesn't support disabling headphone jack...
    vmsg "disable_headphones"
}



######################################################################
# Function:    enable_channel
# Purpose:     Used to enable a sound channel.
# Paramters:   Channel(s) to enable.  
#               Valid options are:
#                   CHANNEL_ALL
#                   CHANNEL_NONE
#                   CHANNEL_HP_LEFT
#                   CHANNEL_HP_RIGHT
#                   CHANNEL_HP_STEREO
#                   CHANNEL_SPEAKER_LEFT
#                   CHANNEL_SPEAKER_RIGHT
#                   CHANNEL_SPEAKER_STEREO
#                   CHANNEL_ALL_SPEAKER
# Returns:     none
# Side Effect: none
######################################################################
enable_channel()
{
    CHANNEL=$1

    vmsg "enable_channel(${CHANNEL})"

    case "$1" in
        $CHANNEL_ALL | $CHANNEL_NONE | $CHANNEL_HP_LEFT | $CHANNEL_HP_RIGHT | \
        $CHANNEL_HP_STEREO | $CHANNEL_SPEAKER_LEFT | \
        $CHANNEL_SPEAKER_RIGHT | $CHANNEL_SPEAKER_STEREO | $CHANNEL_ALL_SPEAKER)
            # Channel is valid
            ;;

        *)
            # Channel is not valid
            echo "Invalid channel option $1."
            echo "Value must be between $CHANNEL_NONE and $CHANNEL_ALL_SPEAKER."
            exit 1;
    esac

    #
    # Enable the specified channel(s)
    #
    case "$CHANNEL" in 

        $CHANNEL_ALL)
            # Set all output channels to stereo
            set_balance "$EVEN_BALANCE"
            enable_speakers
            unmute
            ;;

        $CHANNEL_NONE)
            # Set all output channels to stereo, muted
            enable_speakers
            mute
            ;;

        $CHANNEL_HP_STEREO)
            disable_speakers
            enable_headphones
            set_balance "$EVEN_BALANCE"
            unmute
            ;;

        $CHANNEL_HP_LEFT)
            disable_speakers
            enable_headphones_left
            set_balance "$FULL_LEFT"
            unmute
            ;;

        $CHANNEL_HP_RIGHT)
            disable_speakers
            enable_headphones_right
            set_balance "$FULL_RIGHT"
            unmute
            ;;

        $CHANNEL_SPEAKER_STEREO | $CHANNEL_ALL_SPEAKER)
            enable_speakers
            set_balance "$EVEN_BALANCE"
            unmute
            ;;

        $CHANNEL_SPEAKER_LEFT)
            enable_speakers
            set_balance "$FULL_LEFT"
            unmute
            ;;

        $CHANNEL_SPEAKER_RIGHT)
            enable_speakers
            set_balance "$FULL_RIGHT"
            unmute
            ;;

        *)
            ;;
    esac

}


######################################################################
# Function:    disable_channel
# Purpose:     Used to disable a sound channel.
# Paramters:   Channel(s) to disable.  
#               Valid options are:
#                   CHANNEL_ALL
#                   CHANNEL_NONE
#                   CHANNEL_HP_LEFT
#                   CHANNEL_HP_RIGHT
#                   CHANNEL_HP_STEREO
#                   CHANNEL_SPEAKER_LEFT
#                   CHANNEL_SPEAKER_RIGHT
#                   CHANNEL_SPEAKER_STEREO
#                   CHANNEL_ALL_SPEAKER
# Returns:     none
######################################################################
disable_channel()
{
    CHANNEL=$1
    vmsg "disable_channel(${CHANNEL})"
    case "$CHANNEL" in
        $CHANNEL_ALL | $CHANNEL_NONE | $CHANNEL_HP_LEFT | $CHANNEL_HP_RIGHT | \
        $CHANNEL_HP_STEREO | $CHANNEL_SPEAKER_LEFT | \
        $CHANNEL_SPEAKER_RIGHT | $CHANNEL_SPEAKER_STEREO | $CHANNEL_ALL_SPEAKER)
            # Channel is valid
            ;;

        *)
            # Channel is not valid
            echo "Invalid channel option $CHANNEL."
            echo "Value must be between $CHANNEL_NONE and $CHANNEL_ALL_SPEAKER."
            exit 1;
    esac


    #
    # Disable the specified channel(s)
    #
    case "$CHANNEL" in 
        $CHANNEL_ALL)
            # Set all output channels to stereo
            disable_speakers
            disable_headphones
            mute
            ;;

        $CHANNEL_HP_STEREO)
            disable_headphones
            ;;

        $CHANNEL_HP_LEFT)
            set_hp_balance "$FULL_RIGHT"
            mute
            ;;

        $CHANNEL_HP_RIGHT)
            # Don't think we have individual control 
            # over LEFT HP vs. FULL speaker
            set_hp_balance "$FULL_LEFT"
            mute
            ;;

        $CHANNEL_SPEAKER_STEREO | $CHANNEL_ALL_SPEAKER)
            disable_speakers
            mute
            ;;

        $CHANNEL_SPEAKER_LEFT)
            set_speaker_balance "$FULL_RIGHT"
            mute
            ;;

        $CHANNEL_SPEAKER_RIGHT)
            set_speaker_balance "$FULL_RIGHT"
            mute
            ;;

        $CHANNEL_NONE|*)
            ;;

    esac
}


######################################################################
# Function:    audio_set_parms
# Purpose:     Set channel balance and volume out
# Paramters:   channel - channel(s) to enable
#              volume - volume to set
# Returns:     none
######################################################################
audio_set_parms()
{
    enable_channel $1
    set_volume_out $2 $1
}



######################################################################
# Function:    set_volume_in
# Purpose:     Set all input volume sources to user defined level
# Paramters:   level - desired volume level as a percentage of maximum
# Returns:     none
######################################################################
set_volume_in()
{
    # No mic / volume in for Mario...
    vmsg "set_volume_in"
}


######################################################################
# Function:     audio_set_volume_out
# Purpose:      Remember the audio volume setting (set the volume variable)
# Paramters:    volume to remember
# Returns:      none
# Side Effect:  Sets AUDIO_VOLUME
######################################################################
audio_set_volume_out()
{
    export AUDIO_VOLUME=$1
}


######################################################################
# Function:     audio_get_volume_out
# Purpose:      Return the remembered audio volume setting
# Paramters:    none
# Returns:      Last volume set via audio_set_volume_out()
######################################################################
audio_get_volume_out()
{
    return $AUDIO_VOLUME
}


######################################################################
# Function:     audio_restore_volume_out
# Purpose:      Restore the actual volume to the last remembered volume.
# Paramters:    none
# Returns:      none
# Side Effects: Adjusts volume
######################################################################
audio_restore_volume_out()
{
    set_volume_out $AUDIO_VOLUME
}


_get_left_volume_given_balance()
{
    LEVEL=$1
    case "$AUDIO_BALANCE_SET" in
        $FULL_RIGHT)
            return $_LL_VOLUME_MUTE
            ;;
        *)
            return $LEVEL
            ;;
    esac
}

_get_right_volume_given_balance()
{
    LEVEL=$1
    case "$AUDIO_BALANCE_SET" in
        $FULL_LEFT)
            return $_LL_VOLUME_MUTE
            ;;
        *)
            return $LEVEL
            ;;
    esac
}

_low_level_volume_set()
{
    # Make Level between 0 and 14 inclusive, 
    let LEVEL=$1
    let LEVEL=$LEVEL/7
    case "$LEVEL" in
        # Table for R10 and 11 with 8 bits of 0.5dB steps, 0 to -127dB
        14) export AUDIO_VOLUME_LEVEL=511;  ;; # 1 FF = -0dB
        13) export AUDIO_VOLUME_LEVEL=505;  ;; # 1 F9 = -3dB
        12) export AUDIO_VOLUME_LEVEL=499;  ;; # 1 F3 = -6dB
        11) export AUDIO_VOLUME_LEVEL=494;  ;; # 1 EE = -8.5dB
        10) export AUDIO_VOLUME_LEVEL=487;  ;; # 1 E7 = -12dB
        9)  export AUDIO_VOLUME_LEVEL=481;  ;; # 1 E1 = -15dB
        8)  export AUDIO_VOLUME_LEVEL=472;  ;; # 1 D8 = -19.5dB
        7)  export AUDIO_VOLUME_LEVEL=469;  ;; # 1 D5 = -21dB
        6)  export AUDIO_VOLUME_LEVEL=463;  ;; # 1 CF = -24dB
        5)  export AUDIO_VOLUME_LEVEL=457;  ;; # 1 C9 = -27dB
        4)  export AUDIO_VOLUME_LEVEL=451;  ;; # 1 C3 = -30.5dB
        3)  export AUDIO_VOLUME_LEVEL=445;  ;; # 1 BD = -33dB
        2)  export AUDIO_VOLUME_LEVEL=439;  ;; # 1 B7 = -36dB
        1)  export AUDIO_VOLUME_LEVEL=433;  ;; # 1 B1 = -39dB
        *)  export AUDIO_VOLUME_LEVEL=256;  ;; # 1 00 = mute
    esac

    # Convert value from the decimal value returned to a hex value
    _get_left_volume_given_balance   $AUDIO_VOLUME_LEVEL
    export AUDIO_LEFT_VOLUME_LEVEL=`eval printf "%x" "$?"`
    _get_right_volume_given_balance   $AUDIO_VOLUME_LEVEL
    export AUDIO_RIGHT_VOLUME_LEVEL=`eval printf "%x" "$?"`

    # Now set volume based on balance
    case "$AUDIO_BALANCE_SET" in
        $FULL_LEFT)
            # R26 = 0x17B (Disable right DAC)
            write_reg 26 0x17B
            write_reg $LEFT_AUDIO_REG $AUDIO_LEFT_VOLUME_LEVEL
            write_reg $RIGHT_AUDIO_REG $AUDIO_RIGHT_VOLUME_LEVEL
            return
            ;;

        $FULL_RIGHT)
            # R26 = 0xFB (Disable left DAC)
            write_reg 26 0xFB
            write_reg $LEFT_AUDIO_REG $AUDIO_LEFT_VOLUME_LEVEL
            write_reg $RIGHT_AUDIO_REG $AUDIO_RIGHT_VOLUME_LEVEL
            return            
            ;;

        *)
            # Stereo, enable both DACs
            #write_reg 26 0x1FB
            write_reg $LEFT_AUDIO_REG $AUDIO_LEFT_VOLUME_LEVEL
            write_reg $RIGHT_AUDIO_REG $AUDIO_RIGHT_VOLUME_LEVEL
            return            
            ;;

    esac
}


######################################################################
# Function:    set_volume_out
# Purpose:     Sets the device output volume
# Paramters:   Number between 0 and 100 representing percentage of 
#               maximum volume to set device to.
#
#               This function will set ALL possible output volumes
# Returns:     none
# Side Effects: All output channels will be set to user-defined volume.
######################################################################
set_volume_out()
{
    # Verify parameter is integer between 0 and 100
    let LEVEL=$1
    export AUDIO_VOLUME=$LEVEL
    if [ $# -ge 2 ]; then
        CHANNELS=$2
    fi
    nonums="$(echo $LEVEL |  sed 's/[0-9]//g')"
    if [ ! -z "$nonums" ] ; then
        echo "Volume percentage '$LEVEL' must be an integer value."
        exit 0
    elif [ $LEVEL -gt 100 ]; then
        echo "Volume percentage '$LEVEL' must be integer between 0 and 100."
        exit 0
    fi

    # Set volume to user-defined level
    vmsg "set_volume_out:  ${LEVEL}"%
    if [ $# -ge 2 ]; then
        _low_level_volume_set $LEVEL $CHANNELS
    else
    	_low_level_volume_set $LEVEL
    fi 
}


set_volume()
{
    set_volume_out "$@"
}


######################################################################
# Function:    get_volume_out
# Purpose:     Gets the device output volume
# Paramters:   none
# Returns:     Echoes the current volume out setting
######################################################################
get_volume_out()
{
    # Get volume 
    if [ -n $AUDIO_VOLUME ]; then
        echo "$AUDIO_VOLUME"
    else
        echo "$DEFAULT_VOLUME"
    fi
}



######################################################################
# Function:    set_speaker_volume
# Purpose:     Sets the device speaker output volume
# Paramters:   Number between 0 and 100 representing percentage of 
#               maximum volume to set device to.
#
#               This function will set ALL possible output volumes
# Returns:     none
# Side Effects: All output channels (headphones and speakers) will be 
#               set to user-defined volume.
######################################################################
set_speaker_volume()
{
    set_volume_out "$@"
}


######################################################################
# Function:     set_hp_volume
# Purpose:      Sets the device headphone output volume
# Paramters:    Number between 0 and 100 representing percentage of 
#               maximum volume to set device to.
#
#               This function will set ALL possible output volumes
# Returns:      none
# Side Effects: All output channels (headphones and speakers) will be 
#               set to user-defined volume.
######################################################################
set_hp_volume()
{
    set_volume_out "$@"
}



######################################################################
# Function:     verify_audio_system_support
# Purpose:      Verify that all system support required for the audio
#               diagnostics is in the system (tools are present and
#               executable, lipc calls are supported, etc)
# Paramters:    none
# Returns:      0        - Passed system software support verification
#               Non-zero - Failed system software support verification
#               
#               Failure results include:
#                   AUDIO_PLAY_TOOL_BROKEN - Audio Play tool is missing/broken
#                   AUDIO_ENTRY_FOR_CODEC_MISSING - Codec access /sys entry point is missing
#                   AUDIO_SERVER_MISSING - audioServer tool couldn't be found
######################################################################
verify_audio_system_support()
{
    #
    # Verify Audio Play App
    #
    if ! [ -x ${PLAY_TOOL} ]; then
        echo "Audio Play tool $RUN_PLAY_TOOL is missing"
        failure "Audio Play tool missing."
        return $AUDIO_PLAY_TOOL_BROKEN
    fi

	# Make sure our codec access point is there
    if ! [ -f $AUDIO_REGISTER_SELECT_ENTRY ]; then
        echo "Cannot find $AUDIO_REGISTER_SELECT_ENTRY"
        failure "Codec sys entry for wm8960_reg is missing"
        return $AUDIO_ENTRY_FOR_CODEC_MISSING
    fi

    if ! [ -f $AUDIO_REGISTER_SET_ENTRY ]; then
        echo "Cannot find $AUDIO_REGISTER_SET_ENTRY"
        failure "Codec sys entry for wm8960_register is missing"
       	return $AUDIO_ENTRY_FOR_CODEC_MISSING
    fi

    # Make sure audioServer is there
    if ! [ -f $AUDIO_SERVER_TOOL ]; then
        echo "Cannot find $AUDIO_SERVER_TOOL"
        failure "audioServer tool is missing."
       	return $AUDIO_SERVER_MISSING
    fi

    # If we made it here, all's good.
    return 0
}

######################################################################
# Function:     get_speaker_volume
# Purpose:      Return the currently set speaker volume on the device
# Paramters:    none
# Returns:      none
# Side Effect:  Echo's the volume
######################################################################
get_speaker_volume()
{
    get_volume_out
}


