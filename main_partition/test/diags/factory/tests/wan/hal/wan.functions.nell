    fi
    do_local_echo "WAN PEER: $WAN_PEER"
    vmsg "wan_get_peer() returning $WAN_PEER"
}


######################################################################
# Function:     wan_verify_peer
# Purpose:      Given a WAN peer, verify that it has the right realm
# Paramters:    peer - The WAN peer for the device.  One of:
#                   WAN_PEER_QES            - Peer is QES
#                   WAN_PEER_WHISPERNET_TWO - Peer is Whispernet 2
#                   WAN_PEER_ATT            - Peer is AT&T
#               realm - the realm read from the WAN module
# Returns:      0 - Peer verified OK
#               1 - Peer is invalid
######################################################################
wan_verify_peer()
{
    _PEER="$1"
    _REALM="$2"
    _FAILED=0
    case "$_PEER" in
        $WAN_PEER_QES)
            if ! [ "$_REALM" == "$WAN_PEER_QES_REALM" ]; then
            	if ! [ "$_REALM" == "$WAN_PEER_QES_ROAM_REALM" ]; then
                	_FAILED=1
		fi
            fi
            ;;

        $WAN_PEER_WHISPERNET_TWO)
            echo "$_REALM" | grep -i "$WAN_PEER_WHISPERNET_TWO_REALM"
            if [ "$?" -eq 1 ]; then
                _FAILED=1
            fi
            ;;

        $WAN_PEER_ATT)
            if ! [ "$_REALM" == "$WAN_PEER_ATT_REALM" ]; then
                _FAILED=1
            fi
            ;;

        *)
            _FAILED=1
            ;;
    esac
    return $_FAILED
}


######################################################################
# Function:     wan_get_peer_string
# Purpose:      Given a number representing a peer, return the string
#               name of the peer.
# Paramters:    Peer number.  One of:
#                   1 - QES
#                   2 - Whispernet 2
#                   3 - AT&T
#                   4 - Vodafone
# Returns:      none
# Side Effects: Echo's the name of the carrier, or "Unknown" if parameter
#               was not a 1, 2, or 3.
######################################################################
wan_get_peer_string()
{
    # Convert PEER number into string of carrier
    case "$1" in
        $WAN_PEER_QES)              echo "QES"; ;;
        $WAN_PEER_WHISPERNET_TWO)   echo "Whispernet 2"; ;;
        $WAN_PEER_ATT)              echo "ATT"; ;;
        $WAN_PEER_VODAFONE)         echo "Vodafone"; ;;
        *)                          echo "Unknown"; ;;
    esac
}


######################################################################
# Function:     wan_get_realm_from_peer
# Purpose:      Given a peer, return the realm associated with it
# Paramters:    peer - One of:
#                   WAN_PEER_QES            - QES peer
#                   WAN_PEER_WHISPERNET_TWO - Whispernet 2 peer
#                   WAN_PEER_ATT            - AT&T peer
# Returns:      none
# Side Effect:  Echo's the realm for the given peer
######################################################################
wan_get_realm_from_peer()
{
    # Convert PEER number into string of carrier
    case "$1" in
        $WAN_PEER_QES)              echo "$WAN_PEER_QES_REALM"; ;;
        $WAN_PEER_WHISPERNET_TWO)   echo "$WAN_PEER_WHISPERNET_TWO_REALM"; ;;
        $WAN_PEER_ATT)              echo "$WAN_PEER_ATT_REALM"; ;;
        *)                          echo "Unknown"; ;;
    esac
}


