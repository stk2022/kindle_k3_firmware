######################################################################
# Function:     wan_get_module_version
# Purpose:      Get the WAN module's firmware version from the WAN module
# Paramters:    none
# Returns:      0 - success getting firmware version
#               non-zero - error returnred from lipc-get-prop trying to
#                           get WAN module's firmware version
# Side Effects: Sets the WAN_MODULE_FIRMWARE_VERSION global variable
######################################################################
wan_get_module_version()
{
    export WAN_MODULE_FIRMWARE_VERSION=`lipc-get-prop $WAN_DBUS_ENTRYPOINT radioFirmwareVersion`
    RETVAL=$?
    if [ $RETVAL -eq 0 ]; then
        vmsg "wan_get_module_version() returning $WAN_MODULE_FIRMWARE_VERSION"
        do_local_echo "Module Version: $WAN_MODULE_FIRMWARE_VERSION"
    else
        do_local_echo "Error $RETVAL getting module version from WAN module"
        export WAN_MODULE_FIRMWARE_VERSION="Not Available"
    fi
    return $RETVAL
}


