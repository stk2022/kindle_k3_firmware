######################################################################
# Function:     wan_type_to_name
# Purpose:      Given a WAN module type, returns the name of the module
# Paramters:    type - one of:
#                   WAN_TYPE_ANYDATA,
#                   WAN_TYPE_NOVATEL_E72X,
#                   WAN_TYPE_NOVATEL_E8X0,
#                   WAN_TYPE_UNKNOWN
# Returns:      echo's name of module
######################################################################
wan_type_to_name()
{
    case "$1" in
        $WAN_TYPE_ANYDATA)
            echo "AnyData"
            ;;
        $WAN_TYPE_NOVATEL_E72X)
            echo "Novatel e725-e727"
            ;;
        $WAN_TYPE_NOVATEL_E8X0)
            echo "Novatel e860-e870"
            ;;
        $WAN_TYPE_UNKNOWN | *)
            echo "Unknown"
            ;;
    esac
}

######################################################################
# Function:     wan_get_type
# Purpose:      Get the WAN Module type
# Paramters:    none
# Returns:      echo's one of the following:
#                   AnyData
#                   Novatel e725-e727
#                   Novatel e860-e870
#                   Unknown
# Side Effects: Sets the WAN_TYPE global variable to echo'd string
######################################################################
wan_get_type()
{
    if [ -f "/var/local/wan/info" ]; then
        source "/var/local/wan/info"
    else
        do_local_echo "WAN info file not found in wan_get_type()"
    fi
    do_local_echo "WAN TYPE: $WAN_TYPE"
}


######################################################################
# Function:     wan_display_modem_info_timeout
# Purpose:      Display a message telling the user we timed out waiting
#               for modem info to become available, waiting for user
#               to respond before continuing.
# Paramters:    none
# Returns:      none
######################################################################
wan_display_modem_info_timeout()
{
    # Display information to the user
    clear_screen
    print_center_text "WAN Module Info Timeout" "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~" 8 4
    ${DOUT} -n 15 8 "FAILURE"
    ${DOUT} -n 8 11 "Timed out waiting for WAN module"
    ${DOUT} -n 8 13 "information to become available."
    ${DOUT} 8 17 "Press $EXIT_KEY_LABEL to exit the WAN diagnostic."
    wait_for_key $EXIT_KEY
}


######################################################################
# Function:     init_wan_is_gsm
# Purpose:      Initialize the WAN_IS_GSM global by determing modem
#               type and then determining if it's gsm (type=3)
# Paramters:    none
# Returns:      none
# Assumption:   WAN modem is powered on
######################################################################
init_wan_is_gsm()
{
    # Determine if we're using GSM WAN module
    _WAN_TYPE=`cat /proc/wan/type`
    if [ $_WAN_TYPE -eq $MODEM_TYPE_AD_DTP ]; then
        echo "WAN Module is GSM-based"
        export WAN_IS_GSM=1
    else
        echo "WAN Module is NOT GSM-based"
        export WAN_IS_GSM=0
    fi
}


######################################################################
# Function:     wan_is_gsm
# Purpose:      Determine if WAN module is gsm or not.
# Paramters:    none
# Returns:      0 - WAN is NOT GSM
#               1 - WAN is GSM
# Assumption:   WAN modem is powered on
######################################################################
wan_is_gsm()
{
    if [ $WAN_IS_GSM -eq $WAN_TYPE_UNINITIALIZED ]; then
        init_wan_is_gsm
    fi
    return $WAN_IS_GSM
}


######################################################################
# Function:     get_wan_module_information
# Purpose:      Gather up WAN module information.
# Paramters:    none
# Returns:      0 - success
#               1 - the wan info file was not found
# Assumptions:  WAN is powered on
# Side Effect:  Sets the following global variables:
#                   WAN_ESN (if non-GSM)
#                   WAN_ICCID (if GSM)
#                   WAN_MSID
#                   WAN_MDN
#                   WAN_PRL_VERSION
#                   WAN_TYPE
#                   DEVICE_SERIAL_NUMBER
#                   WAN_MODULE_INFORMATION_GATHERED
######################################################################
get_wan_module_information()
{
    # First, make sure that the WAN info file has been created,
    # which it should since the modem is supposed to be powered on.
    if ! [ -f "/var/local/wan/info" ]; then
        return 1
    fi

    # Grab iccid if gsm, realm & esn otherwise
    wan_is_gsm
    if [ "$?" -eq 1 ]; then
        # Set WAN_ICCID global
        wan_get_iccid
    else
        # Set WAN_MDN global
        wan_get_mdn

        # Set WAN_REALM global
        wan_get_realm
    fi

    # Set WAN_ESN global
    wan_get_esn

    # Set WAN_MSID global
    wan_get_msid

    # Set WAN_PEER global
    wan_get_peer

    # Set WAN_PRL_VERSION global
    wan_get_prl_version

    # Set WAN_TYPE global
    wan_get_type

    # Set DEVICE_SERIAL_NUMBER global
    get_device_serial_number

    # Set the WAN_MODULE_FIRMWARE_VERSION global
    wan_get_module_version

    # Set the global to indicate we've gathered this information
    export WAN_MODULE_INFORMATION_GATHERED=1

    # Return success
    return 0
}



######################################################################
# Function:     wan_display_power_failure
# Purpose:      Display a test failure message to the user
# Paramters:    mode - wan target power mode, one of:
#                   WAN_POWER_ON, WAN_POWER_OFF, WAN_POWER_TPH
#               verify - 0 to require operator to dismiss dialog
#                        1 to auto-dismiss dialog
# Returns:      none
######################################################################
wan_display_power_failure()
{
    MODE="$1"
    NO_OPERATOR_VERIFY="$2"
    case "$MODE" in
        $WAN_POWER_ON)
            MODE_TEXT="on"
            ;;
        $WAN_POWER_OFF)
            MODE_TEXT="off"
            ;;
        $WAN_POWER_TPH | $WAN_POWER_ON_TO_TPH)
            MODE_TEXT="into TPH mode"
            ;;
        *)
            MODE_TEXT="Unknown"
    esac

    # Tell user about the failure
    clear_screen
    banner="WAN Module Failure"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 8 5 "$base"
    center_text "FAILURE" 8 "$base"
    ${DOUT} -n $? 8 "FAILURE"

    banner="Timed out waiting for WAN Module to power $MODE_TEXT."
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 11 "$banner"
    
    if [ $NO_OPERATOR_VERIFY -eq 1 ]; then
        ${DOUT} 4 22 ""
        sleep $WAN_DISPLAY_TIME_AUTO_MODE
    else
        banner="Press $EXIT_KEY_LABEL to exit WAN test."
        center_text "$banner" 8 "$base"
        ${DOUT} $? 16 "$banner"
        wait_for_key $EXIT_KEY
    fi
}


######################################################################
# Function:     wan_get_modem_info_no_wait
# Purpose:      Collect up modem information from WAN module and load
#				up the globals.  To do this, we power on the WAN, wait
#				for it to power up, request the information, then send
#				command to power down the WAN, but don't wait for the
#				power down to complete.
# Parameters:	none
# Returns:      0 - success
#               1 - Failed to get WAN information
#               2 - Failed to power WAN off
# Side Effect:  sets WAN information globals
######################################################################
wan_get_modem_info_no_wait()
{
    # Turn the WAN on, showing status...
    wan_info_power $WAN_POWER_ON 1
    RETVAL=$?
    if [ $RETVAL -eq 1 ]; then
        wan_display_power_failure $WAN_POWER_ON $NO_OPERATOR_VERIFY
		export RUN_IN_FAILURE_REASON="WAN Power On Timeout"
        failure "$RUN_IN_FAILURE_REASON"
        return 1
    fi


    # Wait for the module information to become available,
    # timing out if it takes too long....
    WAIT_COUNT=0
    while [ 1 -ne `lipc-get-prop $WAN_DBUS_ENTRYPOINT radioInfoIsAvailable` ]; do
        WAIT_COUNT=$(($WAIT_COUNT+1));
        if [ $WAIT_COUNT -ge $WAN_INFO_READY_TIMEOUT ]; then
            wan_info_power $WAN_POWER_OFF 1
            return 1
        fi
        sleep 1
    done

    # Get information from the module...
    get_wan_module_information
    RETVAL=$?
    if [ $RETVAL -eq 1 ]; then
        failure "WAN info file not created properly"
        return 1
    fi

    # Turn the WAN back off, showing status...
	wan_power_background $WAN_POWER_OFF 1
    RETVAL=$?
    if [ $RETVAL -eq 1 ]; then
        return 2
    fi

	return 0
}


######################################################################
# Function:     wan_modem_info_test
# Purpose:      Collect up modem information from WAN module and display
#               the results on the screen for the user.  Ask user to
#               verify results are correct and wait for a success/failure
#               response.  Set the subtest result based on user's response.
# Paramters:    1 - diag running in auto mode, suppress asking for operator input
#               0 - diag running with operator, ask for test verification
# Returns:      0 - Test passed
#               1 - Test failed
# Side Effect:  1) Displays a dialog on the screen with modem information,
#               waiting for user to respond.
#               2) Sets subtest result
#               3) Powers on WAN to get information from it, turns it
#                   off when it's done...
######################################################################
wan_modem_info_test()
{
    # Running in auto mode or not?
    NO_OPERATOR_VERIFY=$1

    # Turn the WAN on, showing status...
    wan_info_power $WAN_POWER_ON 1
    RETVAL=$?
    if [ $RETVAL -eq 1 ]; then
        wan_display_power_failure $WAN_POWER_ON $NO_OPERATOR_VERIFY
		export RUN_IN_FAILURE_REASON="WAN Power On Timeout"
        failure "$RUN_IN_FAILURE_REASON"
        return 1
    fi

    #
    # IF on GSM-based modem, while waiting for module information, 
    # make sure to watch for fatalFailure,
    # and if seen, check to see if we have a SIM error or not
    #
    wan_is_gsm
    if [ "$?" -eq 1 ]; then
        # lipc-wait-event com.lab126.wan fatalFailure > file &
        #
        # file will contain the failure code. -13 means that the signal 
        # thread failed to start, which is likely the SIM on GSM devices.
        # TODO - implement this as background checker... njv
        #
        echo "GSM modem, would dispatch SIM watcher here...."
    fi

    # Wait for the module information to become available,
    # timing out if it takes too long....
    WAIT_COUNT=0
    while [ 1 -ne `lipc-get-prop $WAN_DBUS_ENTRYPOINT radioInfoIsAvailable` ]; do
        WAIT_COUNT=$(($WAIT_COUNT+1));
        if [ $WAIT_COUNT -ge $WAN_INFO_READY_TIMEOUT ]; then
            wan_display_modem_info_timeout
			export RUN_IN_FAILURE_REASON="WAN Module Info Timeout"
        	failure "$RUN_IN_FAILURE_REASON"

            # Turn the WAN back off, showing status...
            wan_info_power $WAN_POWER_OFF 1
            RETVAL=$?
            if [ $RETVAL -eq 1 ]; then
                wan_display_power_failure $WAN_POWER_OFF $NO_OPERATOR_VERIFY
				export RUN_IN_FAILURE_REASON="WAN Power Off Timeout"
        		failure "$RUN_IN_FAILURE_REASON"
            fi
            return 1
        fi
        sleep 1
    done

    # Get information from the module...
    get_wan_module_information
    _result=$?
    if [ $_result -eq 1 ]; then
        failure "WAN info file not created properly"
        return 1
    fi


	# Write out some WAN info to a file for the diag disable operation to use
    wan_is_gsm
    if [ "$?" -eq 1 ]; then
        echo "IMEI:              $WAN_ESN" > "$WAN_INFORMATION_LOGFILE"
        echo "ICCID:             $WAN_ICCID" >> "$WAN_INFORMATION_LOGFILE"
    else
        echo "ESN:               $WAN_ESN" > "$WAN_INFORMATION_LOGFILE"
        echo "MDN:               $WAN_MDN" >> "$WAN_INFORMATION_LOGFILE"
        #echo "Realm:             $WAN_REALM" >> "$WAN_INFORMATION_LOGFILE"
    fi
    echo "MSID:              $WAN_MSID" >> "$WAN_INFORMATION_LOGFILE"

    # Turn the WAN back off, showing status...
    wan_info_power $WAN_POWER_OFF 1
    RETVAL=$?
    if [ $RETVAL -eq 1 ]; then
        wan_display_power_failure $WAN_POWER_OFF $NO_OPERATOR_VERIFY
		export RUN_IN_FAILURE_REASON="WAN Power Off Timeout"
        failure "$RUN_IN_FAILURE_REASON"
        return 1
    fi

    # Get string of carrier
    WAN_PEER_STRING=`wan_get_peer_string $WAN_PEER`

    # Verify the realm if the WAN is NOT GSM (won't work on GSM)
    wan_is_gsm
    if [ "$?" -eq 0 ]; then
        # Verify that the Peer matches the REALM...
        wan_verify_peer $WAN_PEER $WAN_REALM
        if [ "$?" -eq 1 ]; then
            display_wan_peer_realm_failure
            failure "WAN Peer Realm Verification"
        elif ! [ $NO_OPERATOR_VERIFY -eq 1 ]; then
            success "WAN Peer Realm Verification"
        fi
    fi

    # Display information to the user
    clear_screen
    ${DOUT} -n 12 4 "WAN Module Information"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} -n 4 7 "Type          : $WAN_TYPE"

    wan_is_gsm
    if [ "$?" -eq 1 ]; then
        ${DOUT} -n 4 9 "ICCID         : $WAN_ICCID"
    	${DOUT} -n 4 11 "IMEI          : $WAN_ESN"
        let _next_line=13
    else
        ${DOUT} -n 4 9 "MDN           : $WAN_MDN"
        ${DOUT} -n 4 11 "Realm         : $WAN_REALM"
    	${DOUT} -n 4 13 "ESN           : $WAN_ESN"
        let _next_line=15
    fi
    ${DOUT} -n 4 $_next_line "MSID          : $WAN_MSID"
    let _next_line+=2
    ${DOUT} -n 4 $_next_line "PEER          : $WAN_PEER_STRING"
    let _next_line+=2
    ${DOUT} -n 4 $_next_line "Prl Version   : $WAN_PRL_VERSION"
    let _next_line+=2
    ${DOUT} -n 4 $_next_line "FW Version    : $WAN_MODULE_FIRMWARE_VERSION"
    let _next_line+=2
    ${DOUT} -n 4 $_next_line "Serial Number : $DEVICE_SERIAL_NUMBER"
    let _next_line+=4
    
    if [ $NO_OPERATOR_VERIFY -eq 1 ]; then
        ${DOUT} 4 $_next_line ""
        sleep $WAN_DISPLAY_TIME_AUTO_MODE
    else
        ${DOUT} -n 4 $_next_line "Press $SUCCESS_KEY_LABEL if the WAN information is correct."
        let _next_line+=2
        ${DOUT} 4 $_next_line "Press $FAILURE_KEY_LABEL if WAN information is NOT correct."
        while [ 1 -eq 1 ]; do
            KEY=`$GET_KEYBOARD_INPUT`
            RETVAL=$?
            if [ $RETVAL -eq 0 ]; then
                case "$KEY" in
                    $SUCCESS_KEY)
                        success "WAN Module Info Test"
                        return 0
                        ;;

                    $FAILURE_KEY)
                        failure "WAN Module Info Test"
                        return 1
                        ;;

                    *)
                        ;;
                esac
            fi
        done
    fi

    return 0
}


#___________________________________________________________________
#
#   WAN HAL Initialization and Teardown Routines Start Here...
#
#___________________________________________________________________
#

######################################################################
# Function:     wan_hal_init
# Purpose:      Hal initialization routine for WAN.
#               This routine currently doesn't need to do anything.
# Paramters:    none
# Returns:      0 - All support verified present
#				1 - Missing RF Disable proc entry
######################################################################
wan_hal_init()
{
    vmsg "wan_hal_init()"
	if ! [ -f $WAN_RF_DISABLE_PROC_ENTRY ]; then
		failure "WAN RF Disable Entry $WAN_RF_DISABLE_PROC_ENTRY Missing"
		return 1
	fi
	return 0
}


######################################################################
# Function:     wan_hal_exit
# Purpose:      Hal initialization routine for WAN.
#               This routine currently doesn't need to do anything.
# Paramters:    none
# Returns:      none
######################################################################
wan_hal_exit()
{
    vmsg "wan_hal_exit()"
}


# Don't include HAL more than once
if [ "x$_WAN_HAL_INCLUDED" == "x1" ]; then
    return 0
fi

# Time to wait before starting 511 test
export WAN_511_PREWAIT_SECONDS=15

export WAN_POWER_OFF=0
export WAN_POWER_ON=1
export WAN_POWER_TPH=2
export WAN_POWER_ON_TO_TPH=3


# WAN Type
export WAN_TYPE_UNINITIALIZED=255 
export WAN_IS_GSM=$WAN_TYPE_UNINITIALIZED
export MODEM_TYPE_AD_DTP=3 

# WAN Peer Constants
export WAN_PEER_QES=1
export WAN_PEER_WHISPERNET_TWO=2
export WAN_PEER_ATT=3
export WAN_PEER_VODAFONE=4
export WAN_PEER_QES_REALM="QDC3"
export WAN_PEER_QES_ROAM_REALM="QDC3_ROAM"
export WAN_PEER_WHISPERNET_TWO_REALM="@spp307.dl.sprintpcs.com"
export WAN_PEER_ATT_REALM="??"


#
# WAN power macros
#
export RUN_WAN_POWER_OFF="/usr/sbin/wancontrol wanoff"
export RUN_WAN_POWER_ON="/usr/sbin/wancontrol wanon"
export RUN_WAN_POWER_TPH="/usr/sbin/wancontrol wanontph"
export RUN_WAN_POWER_ON_TO_TPH="/usr/sbin/wancontrol devicesleep"


#
# Power state property values as reported by wand
#
export WAN_POWER_STATE_OFF=0
export WAN_POWER_STATE_ON=1
export WAN_POWER_STATE_ASLEEP=2


#
# WAN Types
#
export WAN_TYPE_ANYDATA=0
export WAN_TYPE_NOVATEL_E72X=1
export WAN_TYPE_NOVATEL_E8X0=2
export WAN_TYPE_UNKNOWN=99


#
# WAN information globals
#
export WAN_PRL_VERSION="Not Available"
export WAN_MDN="Not Available"
export WAN_PEER="Not Available"
export WAN_REALM="Not Available"
export WAN_MSID="Not Available"
export WAN_ESN="Not Available"
export WAN_ICCID="Not Available"
export WAN_TYPE="$WAN_TYPE_UNKNOWN"


#
# lipc information
#
export WAN_DBUS_ENTRYPOINT=com.lab126.wan
export POWERD_DBUS_ENTRYPOINT=com.lab126.powerd


#
# Timeouts to wait for success before failing a wan power operation
#
export WAN_POWER_OFF_TIMEOUT=180
export WAN_POWER_ON_TIMEOUT=120
export WAN_POWER_TPH_TIMEOUT=60

#
# If seeing an AT&T simm for first time, modem will reboot
# and extra time would cause timeout failure when set to
# 20 seconds.  We boost this timeout to 60 seconds to account
# for the AT&T SIMM case
#
export WAN_INFO_READY_TIMEOUT=60 
 
#
# Proc entry to disable RF mode
#
export WAN_RF_DISABLE_PROC_ENTRY="/proc/wan/enable"


#
# Constants for WAN 511 test
#
export WAN_511_RESULTS_TMP_FILE="/tmp/511.log"
export WAN_511_RESULTS_FILENAME="${PRODUCT_NAME}-511.log"
export WAN_511_RESULTS_OUTPUT_FILE="/tmp/${WAN_511_RESULTS_FILENAME}"

# Minimum power level for RF test - warning if under 60%
export WAN_511_BATTERY_LEVEL=60

export _WAN_HAL_INCLUDED=1

# Timeout waiting for startWan to return success status
export WAN_STARTWAN_POWERON_TIMEOUT=34 
