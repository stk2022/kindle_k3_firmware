# wifi max power level for Tx continuous test
export WIFI_POWER_LEVEL_MAX____ITEM_1=$KEY_M
export WIFI_POWER_LEVEL_NORMAL_ITEM_2=$KEY_N

#
# WIFI path information
#
export WIFI_ENTRY_DIR="/sys/devices/system/wifi/wifi0"
export WIFI_ENABLE_ENTRY="$WIFI_ENTRY_DIR/wifi_enable"


#
# Power state property values
#
export WIFI_POWER_STATE_OFF=0
export WIFI_POWER_STATE_ON=1


#
# WIFI information globals
#
export WIFI_MAC_ADDRESS="00:00:00:00:00:00"


#
# WIFI Chip ID verification tool
#
export WIFI_BMILOADER="/sbin/bmiloader"
export WIFI_NETIF="wlan0" 
export WIFI_CHIP_ID="0x20000188"
#export WIFI_RESPONSE_STRING="AR6000 Reg Code = 0x40000060"
export WIFI_RESPONSE_STRING="WiFi driver installed successfully"


#
# ART environment variable
#
export NETIF=$WIFI_NETIF
# select between "US" or "EU"
export WIFI_BAND="US"
export WIFI_FREQ="2412"
# "1"  := Tx test
# "0"  := Rx test
export WIFI_ART_TEST="1"
export WIFI_MODE="11B"
export WIFI_DATA_RATE_INDEX=0
export WIFI_USE_TARGET_POWER=0
export WIFI_FORCE_ANT_A=0

#
# Wifi driver loading
#
export LOAD_WIFI_DRIVERS="/etc/init.d/wifi"
export UNLOAD_WIFI_DRIVERS="/etc/init.d/wifi stop"

#
# lipc information
#
export WIFI_DBUS_ENTRYPOINT=com.lab126.wifi
export POWERD_DBUS_ENTRYPOINT=com.lab126.powerd


#
# Timeouts to wait for success before failing a wifi power operation
#
export WIFI_POWER_OFF_TIMEOUT=180
export WIFI_POWER_ON_TIMEOUT=120
export WIFI_INFO_READY_TIMEOUT=20 
 
# Minimum power level for RF test - warning if under 60%
export WIFI_511_BATTERY_LEVEL=60 

export _WIFI_HAL_INCLUDED=1
         
