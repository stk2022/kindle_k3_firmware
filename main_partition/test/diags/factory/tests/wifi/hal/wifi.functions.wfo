######################################################################
# Function:     wifi_display_power_failure
# Purpose:      Display a test failure message to the user
# Paramters:    mode - wan target power mode, one of:
#                   WIFI_POWER_ON or WIFI_POWER_OFF
#               verify - 0 to require operator to dismiss dialog
#                        1 to auto-dismiss dialog
# Returns:      none
######################################################################
wifi_display_power_failure()
{
    MODE="$1"
    NO_OPERATOR_VERIFY="$2"
    case "$MODE" in
        $WIFI_POWER_ON)
            MODE_TEXT="on"
            ;;
        $WIFI_POWER_OFF)
            MODE_TEXT="off"
            ;;
        *)
            MODE_TEXT="Unknown"
    esac

    # Tell user about the failure
    clear_screen
    banner="WIFI Module Failure"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 8 5 "$base"
    center_text "FAILED" 8 "$base"
    ${DOUT} -n $? 8 "FAILED"

    banner="Timed out waiting for WIFI Module to power $MODE_TEXT."
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 11 "$banner"
    
    if [ $NO_OPERATOR_VERIFY -eq 1 ]; then
        ${DOUT} 4 22 ""
        sleep $WIFI_DISPLAY_TIME_AUTO_MODE
    else
        banner="Press $EXIT_KEY_LABEL to exit WIFI test."
        center_text "$banner" 8 "$base"
        ${DOUT} $? 16 "$banner"
        wait_for_key $EXIT_KEY
    fi
}


######################################################################
# Function:     wifi_verify_chip_alive
# Purpose:      Verify the wifi chip is alive and responding
# Paramters:    no_operator_verify
#                   1 - Don't require operator to verify results
#                   0 - wait for operator to verify results
# Returns:      0 - Chip responding as expected
#				1 - Chip NOT responding as expected
######################################################################
wifi_verify_chip_alive()
{
    if [ $# -ge 1 ]; then
        NO_OPERATOR_VERIFY=$1
    else
        NO_OPERATOR_VERIFY=0
    fi
    _WIFI_FAILED=0

    # Tell user about the failure
    clear_screen
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print_center_text "WIFI Module Verification" "$base" 8 4
    _msg="Loading wifi drivers now..."
    center_text "$_msg" 8 "$base"
    ${DOUT} $? 8 "$_msg"

    # Load the wifi driver
    # Add timeout to bmiloader to kill it and return bad status

    ${LOAD_WIFI_DRIVERS} > /dev/null 2>&1    &

    # with the latest fix, bmiloader can time out
    CHIP_ALIVE=0

    # bmiloader returns 255 when it fails.
    ${WIFI_BMILOADER} -i wlan0 --info
    ret_val=$?
    if [ $ret_val -eq 0 ]; then
            CHIP_ALIVE=1
        fi
    erase_line 8
    if [ $CHIP_ALIVE -ne 1 ]; then
        center_text "FAILED" 8 "$base"
        ${DOUT} -n $? 8 "FAILED"
        banner="WIFI module failed to respond."

        _WIFI_FAILED=1
        killall -9 wifi
        killall -9 loadAR6000.sh
        killall -9 plat_SHASTA_NATIVEMMC-SDIO.sh
        killall -9 bmiloader

    else
        center_text "PASSED" 8 "$base"
        ${DOUT} -n $? 8 "PASSED"
        banner="WIFI module responded as expected."
    fi
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 11 "$banner"

    if [ $NO_OPERATOR_VERIFY -eq 1 ]; then
        ${DOUT} 4 22 ""
        sleep $WIFI_DISPLAY_TIME_AUTO_MODE
    else
        banner="Press $EXIT_KEY_LABEL to exit WIFI test."
        center_text "$banner" 8 "$base"
        ${DOUT} $? 16 "$banner"
        wait_for_key $EXIT_KEY
    fi
    sleep 5
    # Unload driver before exiting
	echo "unloading WIFI driver"
	${DOUT} 15 10 "unloading WIFI driver"
#    ${UNLOAD_WIFI_DRIVERS} > /dev/null 2>&1
	 ${UNLOAD_WIFI_DRIVERS}
    echo "unloading WIFI driver done"
    ${DOUT} 15 10 "UNLOADING wifi DRIVER done"
    return ${_WIFI_FAILED}
}


#####################################################################
# Function:     wifi_display_511_pass_but_export_failed
# Purpose:      Displays the dialog explaining that the 511 test passed,
#               but that we failed to copy and/or export the file on
#               the exported USB volume.
# Paramters:    1 - Couldn't find source file
#               2 - Couldn't find USB export volume
# Returns:      none
######################################################################
wifi_display_511_pass_but_export_failed()
{
    reason="$1"
    clear_screen
    ${DOUT} -n 14 4 "WIFI 511 Test Results"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} -n 17 9 "FAILED"

    case "$reason" in
        1)
            ${DOUT} -n 8 11 "The 511 test passed, but could not find"
            ${DOUT} -n 8 13 "$WIFI_511_RESULTS_OUTPUT_FILE results file to export."
            ;;
        2)
            ${DOUT} -n 8 11 "The 511 test passed, but could not find"
            ${DOUT} -n 8 13 "$USB_EXPORT_VOLUME to copy file to."
            ;;
        *)
            ${DOUT} -n 8 11 "Unknown test result $reason"
            ;;
    esac
    ${DOUT} 8 16 "Press $EXIT_KEY_LABEL to exit the WIFI 511 test."
    wait_for_key $EXIT_KEY
}


wifi_prep_and_export_511_status()
{
    dev_get_serial_number
    echo -n "$DEVICE_SERIAL_NUMBER" >  "${WIFI_511_RESULTS_OUTPUT_FILE}"

    # Append the MAC address and pcba number, if MAC address is supported
    if [ -n "$HAS_MAC_ADDRESS" ] && [ $HAS_MAC_ADDRESS -eq 1 ]; then
        dev_get_mac_address
        echo -n ",$DEVICE_MAC_ADDRESS" >> "${WIFI_511_RESULTS_OUTPUT_FILE}"
        dev_get_manuf_code
        echo -n ",$DEVICE_MANUF_CODE" >> "${WIFI_511_RESULTS_OUTPUT_FILE}"
        dev_get_pcb_id
        echo ",$DEVICE_PCB_ID" >> "${WIFI_511_RESULTS_OUTPUT_FILE}"
    else
        echo -n "HAS_WIFI = $HAS_WIFI, HAS_MAC_ADDRESS = $HAS_MAC_ADDRESS"
    fi

    # Copy the file to the FAT partition and export it...
    usb_copy_to_export_volume "$WIFI_511_RESULTS_OUTPUT_FILE" "$WIFI_511_RESULTS_FILENAME"
    copy_failed="$?"
    if [ "$copy_failed" -eq 0 ]; then
        export_usb_volumes
        return 0
    else
        clear_screen
        ${DOUT} -n 17 4 "WIFI 511 Test"
        ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
        ${DOUT} -n 8 7 "Failed to copy 511 results file to"
        ${DOUT} -n 8 9 "the USB export volume because"
        if [ $copy_failed -eq 1 ]; then
            ${DOUT} -n 8 11 "$USB_EXPORT_VOLUME is missing."
        else
            ${DOUT} -n 8 11 "$WIFI_511_RESULTS_OUTPUT_FILE is missing."
        fi
        ${DOUT} 8 14 "Press $EXIT_KEY_LABEL to continue."
        wait_for_key $EXIT_KEY
        return 1
    fi


}                                                                                                                                                                 

#####################################################################
# Function:     wifi_display_511_pass_but_export_failed
# Purpose:      Displays the dialog explaining that the 511 test passed,
#               but that we failed to copy and/or export the file on
#               the exported USB volume.
# Paramters:    1 - Couldn't find source file
#               2 - Couldn't find USB export volume
# Returns:      none
######################################################################
wifi_display_511_pass_but_export_failed()
{
    reason="$1"
    clear_screen
    ${DOUT} -n 14 4 "WIFI 511 Test Results"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} -n 17 9 "FAILED"

    case "$reason" in
        1)
            ${DOUT} -n 8 11 "The 511 test passed, but could not find"
            ${DOUT} -n 8 13 "$WIFI_511_RESULTS_OUTPUT_FILE results file to export."
            ;;
        2)
            ${DOUT} -n 8 11 "The 511 test passed, but could not find"
            ${DOUT} -n 8 13 "$USB_EXPORT_VOLUME to copy file to."
            ;;
        *)
            ${DOUT} -n 8 11 "Unknown test result $reason"
            ;;
    esac
    ${DOUT} 8 16 "Press $EXIT_KEY_LABEL to exit the WIFI 511 test."
    wait_for_key $EXIT_KEY
}


######################################################################
# Function:     wifi_display_511_results
# Purpose:      Displays the PASS/FAIL result of the 511 test
# Paramters:    TEST_FAILED - results of 511 test; one of:
#                   0 - Test Passed
#                   1 - Test Failed
# Returns:      none
######################################################################
wifi_display_511_results()
{
    TEST_FAILED="$1"
    clear_screen

    # Center banner
    banner="WIFI 511 Test Results"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 8 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 8 5 "$base"
    case "$TEST_FAILED" in
        0)
            center_text "PASSED" 8 "$base"
            ${DOUT} -n $? 7 "PASSED"
            ${DOUT} -n 6 11 "Copy the $WIFI_511_RESULTS_FILENAME file from the"
            ${DOUT} -n 6 13 "host machines /media/Kindle directory now."
            ${DOUT} -n 6 21 "Press $EXIT_KEY_LABEL to exit the 511 test once the"
            ${DOUT} 6 23 "file has been copied off the device."
            ;;
        1)
            center_text "FAILED" 8 "$base"
            ${DOUT} -n $? 9 "FAILED"
            ${DOUT} 8 13 "Press $EXIT_KEY_LABEL to exit the WIFI 511 test."
            ;;
        *)
            ${DOUT} -n 8 9 "Unknown test result $TEST_FAILED"
            ${DOUT} 8 13 "Press $EXIT_KEY_LABEL to exit the WIFI 511 test."
            ;;
    esac
    wait_for_key $EXIT_KEY
}


######################################################################
# Function:     wifi_display_511_test_running
# Purpose:      Display message telling user we're running the 511 test.
# Paramters:    none
# Returns:      none
######################################################################
wifi_display_511_test_running()
{
    # Display information to the user
    clear_screen
    ${DOUT} -n 17 4 "WIFI 511 Test"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} 8 7 "Running the 511 test."
}


######################################################################
# Function:     wifi_display_battery_low
# Purpose:      Display message telling user we're running the 511 test.
# Paramters:    none
# Returns:      1 - Operator wants to still run 511 test
#               0 - Operator wants to cancel request for 511 test
######################################################################
wifi_display_battery_low()
{
    _CUR_LEVEL="$1"
 
    # Display information to the user
    clear_screen
    ${DOUT} -n 17 4 "WIFI 511 Test"
    ${DOUT} -n 6 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} -n 6 7 "WARNING : The current battery charge level"
    ${DOUT} -n 6 9 "of $_CUR_LEVEL is below recommended level of $WIFI_511_BATTERY_LEVEL."
    ${DOUT} -n 6 13 "Press $SUCCESS_KEY_LABEL to continue 511 test."
    ${DOUT} 6 15 "Press $EXIT_KEY_LABEL to abort 511 test."
    while [ 1 -eq 1 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        if [ $? -eq 0 ]; then
            case "$KEY" in
                $SUCCESS_KEY)
                    return 1
                    ;;

                $EXIT_KEY)
                    return 0
                    ;;

                *)
                    ;;
            esac
        fi
    done
}


######################################################################
# Function:     wifi_511_test
# Purpose:      Tell the system to execute the Wifi 511 test.
# Paramters:    operator_verify
#                   1 to run in cycle (no operator verify) mode
#                   0 to run in operator verify mode
# Returns:      0 - test succeeded
#               1 - test failed
#               2 - operator canceled due to low battery
# Side Effect:  Clears the SUB_TEST_PASSED variable on failure
######################################################################
wifi_511_test()
{
    # Running in auto mode or not?
    NO_OPERATOR_VERIFY=$1

    # Check if we have enough battery juice, warn operator if we don't
    if [ "x$REQUIRE_WIFI_511_POWER" == "x1" ]; then
        BATTERY_LEVEL=`${BATTERY_CAPACITY} | sed s/\%//g` > /dev/null 2>&1
        if [ $BATTERY_LEVEL -lt $WIFI_511_BATTERY_LEVEL ]; then
            wifi_display_battery_low $BATTERY_LEVEL
            if [ $? -eq 0 ]; then
                # Operator wants to cancel test request
                return 2
            fi
        fi
    fi

    # Run the 511 test
    wifi_display_511_test_running

    # Prepare the results file and export it...
    wifi_prep_and_export_511_status
    if [ "$?" -eq 0 ]; then
	wifi_display_511_results 0
        un_export_usb_volumes
        usb_delete_from_export_volume "$WIFI_511_RESULTS_FILENAME"
    else
        wifi_display_511_pass_but_export_failed
    fi

    clear_screen
    success "WIFI 511 Test"

    return 0
}


