######################################################################
# Function:    do_print_art_header
# Purpose:     print common ART header
# Paramters:   none
# Returns:     next line number
######################################################################
do_print_art_header()
{
    clear_screen
    banner="WIFI ART Diagnostics"
    base="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    center_text "$banner" 5 "$base"
    ${DOUT} -n $? 4 "$banner"
    ${DOUT} -n 5 5 "$base"
    return 8
}
     
######################################################################
# Function:    do_run_wifi_art_choose_wifi_band
# Purpose:     Wifi test utility using ART
#              Level 1: Choose WIFI Band, US or EU
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_choose_wifi_band()
{
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Selecting WIFI BAND            "
    let line_number+=2
    text=`keycode_to_label $WIFI_BAND_MENU_ITEM_1`
    ${DOUT} -n 2 $line_number "$text) US Band"
    let line_number+=2
    text=`keycode_to_label $WIFI_BAND_MENU_ITEM_2`
    ${DOUT} -n 2 $line_number "$text) EU Band"
    let line_number+=2
    ${DOUT} 8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    
    while [ $DONE -eq 0 ]; do
         KEY=`$GET_KEYBOARD_INPUT`
         RETVAL=$?
         if [ $RETVAL -eq 0 ]; then
         
             #
             # Process key request
             case "$KEY" in
             
             $WIFI_BAND_MENU_ITEM_1)
                 echo "US band selected..."
                 WIFI_BAND="US"
                 DONE=1
                 ;;
             
             $WIFI_BAND_MENU_ITEM_2)
                 echo "EU band selected..."
                 WIFI_BAND="EU"
                 DONE=1
                 ;;
             
             $EXIT_KEY)
                 # User pressed the target key, verify visual via asking operator
                 DONE=1
                 return ${WIFI_EXIT}
                 ;;
             *)
                 DONE=0
                 ;;
             
             esac
         fi
    done
    echo "choose WIFI band $WIFI_BAND"
    return ${WIFI_SUCCESS}
}


######################################################################
# Function:    do_run_wifi_art_choose_channel
# Purpose:     Wifi test utility using ART
#              Level 2: Choose channel to test: 
#                   * US: 1, 6, 11
#                   * EU: 1, 7, 13
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_choose_channel()
{
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Choose channel                 "
    let line_number=line_number+2
    if [ $WIFI_BAND = "US" ]; then

        text=`keycode_to_label $WIFI_US_CH_MENU_ITEM_1`
        ${DOUT} -n 2 $line_number "$text) US Ch 1  (2412 MHz)"
        let line_number+=2
        text=`keycode_to_label $WIFI_US_CH_MENU_ITEM_2`
        ${DOUT} -n 2 $line_number "$text) US Ch 6  (2437 MHz)"
        let line_number+=2
        text=`keycode_to_label $WIFI_US_CH_MENU_ITEM_3`
        ${DOUT} -n 2 $line_number "$text) US Ch 11 (2462 MHz)"
        let line_number+=2
    else

        text=`keycode_to_label $WIFI_EU_CH_MENU_ITEM_1`
        ${DOUT} -n 2 $line_number "$text) EU Ch 1  (2412 MHz)"
        let line_number+=2
        text=`keycode_to_label $WIFI_EU_CH_MENU_ITEM_2`
        ${DOUT} -n 2 $line_number "$text) EU Ch 7  (2442 MHz)"
        let line_number+=2
        text=`keycode_to_label $WIFI_EU_CH_MENU_ITEM_3`
        ${DOUT} -n 2 $line_number "$text) EU Ch 13 (2472 MHz)"
        let line_number+=2
    fi
    ${DOUT} 8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        RETVAL=$?
        if [ $RETVAL -eq 0 ]; then
        
        #
        # Process key request
        case "$KEY" in
        
            $WIFI_US_CH_MENU_ITEM_1)
                echo "Channel 1 selected..."
                WIFI_FREQ="2412"
                DONE=1
                ;;
            
            $WIFI_US_CH_MENU_ITEM_2)
                echo "Channel 6 selected..."
                WIFI_FREQ="2437"
                DONE=1
                ;;
            $WIFI_US_CH_MENU_ITEM_3)
                echo "Channel 11 selected..."
                WIFI_FREQ="2462"
                DONE=1
                ;;
        
            $WIFI_EU_CH_MENU_ITEM_1)
                echo "Channel 1 selected..."
                WIFI_FREQ="2412"
                DONE=1
                ;;
            $WIFI_EU_CH_MENU_ITEM_2)
                echo "Channel 7 selected..."
                WIFI_FREQ="2442"
                DONE=1
                ;;
            $WIFI_EU_CH_MENU_ITEM_3)
                echo "Channel 13 selected..."
                WIFI_FREQ="2472"
                DONE=1
                ;;
            
            $EXIT_KEY)
                # User pressed the target key, verify visual via asking operator
                DONE=1
                return ${WIFI_EXIT}
                ;;
            *)
                DONE=0
                ;;
            
            esac
        fi
    done
    return ${WIFI_SUCCESS}
}

######################################################################
# Function:    do_run_wifi_art_choose_rate_11b
# Purpose:     Wifi test utility using ART
#              - Choose date rate depending on the mode
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_choose_rate_11b()
{
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Select rate for 11b "
    text=`keycode_to_label $WIFI_DT_RATE_11B___1L_____MBPS_ITEM_1`
    let line_number+=2
    ${DOUT} -n 2 $line_number "$text) Rate 1L Mbps"
    let line_number+=2
    text=`keycode_to_label $WIFI_DT_RATE_11B___2L_____MBPS_ITEM_2`
    ${DOUT} -n 2 $line_number "$text) Rate 2L Mbps"
    let line_number+=2
    text=`keycode_to_label $WIFI_DT_RATE_11B_5_5L_____MBPS_ITEM_4`
    ${DOUT} -n 2 $line_number "$text) Rate 5.5 Mbps"
    let line_number+=2
    text=`keycode_to_label $WIFI_DT_RATE_11B__11L_____MBPS_ITEM_6`
    ${DOUT} -n 2 $line_number "$text) Rate 11 Mbps"
    let line_number+=2

    ${DOUT} 8 line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        RETVAL=$?
        if [ $RETVAL -eq 0 ]; then
    
            #
            # Process key request
            case "$KEY" in
            
            $WIFI_DT_RATE_11B___1L_____MBPS_ITEM_1)
                echo "Rate   1L Mbps selected..."
                WIFI_DATA_RATE_INDEX=$WIFI_DT_RATE_11B___1L_____MBPS
                DONE=1
                ;;

            $WIFI_DT_RATE_11B___2L_____MBPS_ITEM_2)
                echo "Rate   2L Mbps selected..."
                WIFI_DATA_RATE_INDEX=$WIFI_DT_RATE_11B___2L_____MBPS
                DONE=1
                ;;

            $WIFI_DT_RATE_11B_5_5L_____MBPS_ITEM_4)
                echo "Rate 5.5 Mbps selected..."
                WIFI_DATA_RATE_INDEX=$WIFI_DT_RATE_11B_5_5L_____MBPS
                DONE=1
                ;;

            $WIFI_DT_RATE_11B__11L_____MBPS_ITEM_6)
                echo "Rate 11 Mbps selected... "
                WIFI_DATA_RATE_INDEX=$WIFI_DT_RATE_11B___1L_____MBPS
                DONE=1
                ;;

            $EXIT_KEY)
                # User pressed the target key, verify visual via asking operator
                DONE=1
                return ${WIFI_EXIT}
                ;;
            *)
                DONE=0
                ;;
            
            esac
        fi
    done
    return ${WIFI_SUCCESS}
}

