######################################################################
# Function:    do_run_select_tx_power_level
# Purpose:     Wifi test utility using ART
#              Choose power level for Tx continuous test
#                   - MAX power
#                   - NORMAL power
# Paramters:   none
# Returns:     none
######################################################################

do_run_select_tx_power_level()
{
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Select power level for Tx test "
    let line_number+=2
    text=`keycode_to_label $WIFI_POWER_LEVEL_MAX____ITEM_1`
    ${DOUT} -n 2 $line_number "$text) MAX power"
    let line_number+=2
    text=`keycode_to_label $WIFI_POWER_LEVEL_NORMAL_ITEM_2`
    ${DOUT} -n 2 $line_number "$text) NORMAL power"
    let line_number+=2
    ${DOUT} 8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        RETVAL=$?
        if [ $RETVAL -eq 0 ]; then
    
            #
            # Process key request
            case "$KEY" in
            
            $WIFI_POWER_LEVEL_MAX____ITEM_1)
                echo "Max power level selected..."
                WIFI_USE_TARGET_POWER=1
                DONE=1
                ;;
            
            $WIFI_POWER_LEVEL_NORMAL_ITEM_2)
                echo "Normal power level selected..."
                WIFI_USE_TARGET_POWER=0
                DONE=1
                ;;
            
            $EXIT_KEY)
                # User pressed the target key, verify visual via asking operator
                WIFI_USE_TARGET_POWER=0
                DONE=1
                return ${WIFI_EXIT}
                ;;
            *)
                WIFI_USE_TARGET_POWER=0
                DONE=0
                ;;
            
            esac
        fi
    done
    return ${WIFI_SUCCESS}

}

