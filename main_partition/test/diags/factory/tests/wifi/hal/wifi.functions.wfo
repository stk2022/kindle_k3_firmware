# EU band channel 7, 2442 MHz
export WIFI_EU_CH_MENU_ITEM_2=$KEY_T
# EU band channel 13, 2472 MHz
export WIFI_EU_CH_MENU_ITEM_3=$KEY_Y
                                               
                            
