######################################################################
# Function:     wifi_power_inform_user
# Purpose:      Put up a screen informing the user of the WIFI power
#               operation under way
# Parameters:   mode - power mode to put WIFI in; one of:
#                   WIFI_POWER_OFF,
#                   WIFI_POWER_ON,
#               footer - print the full banner/footer; one of:
#                   0 - Don't print the footer
#                   1 - Print the entire screen
# Returns:      none
######################################################################
wifi_power_inform_user()
{
    MODE="$1"
    PRINT_FOOTER=1
    clear_screen
    case "$MODE" in
        $WIFI_POWER_OFF)
            ${DOUT} -n 12 4 "Powering the WIFI off ..."
            ;;
        $WIFI_POWER_ON)
            ${DOUT} -n 12 4 "Powering the WIFI on ..."
            ;;
        *)
            ${DOUT} 8 4 "ERROR: UNKNOWN WIFI POWER MODE $MODE"
            PRINT_FOOTER=0
            ;;
    esac

    if [ $PRINT_FOOTER -eq 1 ]; then
        ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
        ${DOUT} -n 8 7 "This could take up to 2 minutes."
        ${DOUT} -n 8 9 "This screen will auto-dismiss once"
        ${DOUT} 8 11 "the WIFI power operation is complete."
    fi
}



######################################################################
# Function:     wifi_info_power
# Purpose:      Power the WIFI module into one of its three power modes
# Parameters:   mode - power mode to put WIFI module into.
#                   Either WIFI_POWER_OFF or WIFI_POWER_ON.
#               display_status - flag to enable showing of status dialot
#                   0 - Don't show status screen, 
#                   1 - show status screen while wifi power operation in progress,
# Returns:      none
######################################################################
wifi_info_power()
{
    vmsg "wifi_info_power($1)"
    MODE="$1"
    SHOW_STATUS="$2"
    case "$1" in

        $WIFI_POWER_OFF)
            vmsg "Turning WIFI power OFF..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_OFF
            fi
            do_local_echo "Setting WIFI StopWan property to power OFF..."
            lipc-set-prop $WIFI_DBUS_ENTRYPOINT stopWan 0
            do_local_echo "Waiting for WIFI to power off..."

            # Loop waiting for powerState to go off
            WAIT_COUNT=0
            while [ $WIFI_POWER_STATE_OFF -ne `lipc-get-prop $WIFI_DBUS_ENTRYPOINT powerState` ]; do
                WAIT_COUNT=$(($WAIT_COUNT+1));
                if [ $WAIT_COUNT -ge $WIFI_POWER_OFF_TIMEOUT ]; then
                    pstate=`lipc-get-prop $WIFI_DBUS_ENTRYPOINT powerState`
                    do_local_echo "WIFI Power Off pstate = $pstate"
                    return 1
                fi
                sleep 1
            done
            ;;    

        $WIFI_POWER_ON)
            vmsg "Turning WIFI power ON..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_ON
            fi
            do_local_echo "Setting WIFI StartWan property to power ON..."
            lipc-set-prop $WIFI_DBUS_ENTRYPOINT startWan 1
            do_local_echo "Waiting for WIFI to power on..."

            # Loop waiting for WIFI to get powered on
            WAIT_COUNT=0
            while [ $WIFI_POWER_STATE_ON -ne `lipc-get-prop $WIFI_DBUS_ENTRYPOINT powerState` ]; do
                WAIT_COUNT=$(($WAIT_COUNT+1));
                if [ $WAIT_COUNT -ge $WIFI_POWER_ON_TIMEOUT ]; then
                    return 1
                fi
                sleep 1
            done
            ;;    

        *)
            do_local_echo "wifi_info_power(): ERROR - unknown WIFI power mode $1"
            ;;    

    esac
}


######################################################################
# Function:     wifi_power_background
# Purpose:      Power the WIFI module into one of its three power modes.
#               Issue the command in the background to allow returning
#               immediately.
# Paramters:    mode - power mode to put WIFI module into.
#                   One of WIFI_POWER_OFF or WIFI_POWER_ON.
#               display_status - flag to enable showing of status dialot
#                   0 - Don't show status screen, 
#                   1 - show status screen while wifi power operation 
#                       is in progress
# Returns:      none
######################################################################
wifi_power_background()
{
    vmsg "wifi_power_background($1,$2)"
    MODE="$1"
    SHOW_STATUS="$2"
    case "$1" in
        $WIFI_POWER_OFF)
            vmsg "Turning WIFI power OFF in background..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_OFF
            fi
            echo 0 > "$WIFI_ENABLE_ENTRY" > /dev/null 2>&1 &
            ;;    

        $WIFI_POWER_ON)
            vmsg "Turning WIFI power ON in background..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_ON
            fi
            echo 1 > "$WIFI_ENABLE_ENTRY" > /dev/null 2>&1 &
            ;;    

        *)
            do_local_echo "wifi_power_background(): ERROR - unknown WIFI power mode $1"
            ;;    

    esac
}


######################################################################
# Function:     wifi_power
# Purpose:      Power the WIFI module into one of its three power modes.
# Paramters:    mode - power mode to put WIFI module into.
#                   Either WIFI_POWER_OFF or WIFI_POWER_ON.
#               display_status - flag to enable showing of status dialot
#                   0 - Don't show status screen, 
#                   1 - show status screen while wifi power operation in progress,
# Returns:      none
######################################################################
wifi_power()
{
    vmsg "wifi_power($1)"
    MODE="$1"
    SHOW_STATUS="$2"
    case "$1" in
        $WIFI_POWER_OFF)
            vmsg "Turning WIFI power OFF..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_OFF
            fi
            echo 0 > "$WIFI_ENABLE_ENTRY" > /dev/null 2>&1
            ;;    

        $WIFI_POWER_ON)
            vmsg "Turning WIFI power ON..."
            if [ $SHOW_STATUS -eq 1 ]; then
                wifi_power_inform_user $WIFI_POWER_ON
            fi
            echo 1 > "$WIFI_ENABLE_ENTRY" > /dev/null 2>&1
            ;;    
        *)
            do_local_echo "wifi_power(): ERROR - unknown WIFI power mode $1"
            ;;    

    esac
}


