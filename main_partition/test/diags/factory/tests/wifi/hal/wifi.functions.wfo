######################################################################

do_run_select_antenna()
{
    # currently 
    WIFI_FORCE_ANT_A=0
    
    return
}

######################################################################
# Function:    do_run_wifi_art_choose_test
# Purpose:     Wifi test utility using ART
#              Level 3: Choose Tx or Rx test
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_choose_test()
{
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Selectig test                "
    let line_number+=2
    text=`keycode_to_label $WIFI_TEST_MENU_ITEM_1`
    ${DOUT} -n 2 $line_number "$text) Tx continuous"
    let line_number+=2
    text=`keycode_to_label $WIFI_TEST_MENU_ITEM_2`
    ${DOUT} -n 2 $line_number "$text) Rx"
    let line_number+=2
    ${DOUT} 8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    while [ $DONE -eq 0 ]; do
        KEY=`$GET_KEYBOARD_INPUT`
        RETVAL=$?
        if [ $RETVAL -eq 0 ]; then
    
            #
            # Process key request
            case "$KEY" in
            
            $WIFI_TEST_MENU_ITEM_1)
                echo "Tx continuous test selected..."
                WIFI_ART_TEST="1"
                # select power level for the Tx test
                do_run_select_tx_power_level
                DONE=1
                ;;
            
            $WIFI_TEST_MENU_ITEM_2)
                echo "Rx test selected..."
                WIFI_ART_TEST="0"
                DONE=1
                ;;
            
            $EXIT_KEY)
                # User pressed the target key, verify visual via asking operator
                DONE=1
                return ${WIFI_EXIT}
                ;;
            *)
                DONE=0
                ;;
            
            esac
        fi
    done
    return ${WIFI_SUCCESS}

}

do_extract_art()
{
    if [ -f ${DIAGNOSTIC_ROOT}/tests/wifi/art_files.tar ]; then
        cd ${DIAGNOSTIC_ROOT}/tests/wifi/
        mntroot_rw
        tar -xvf art_files.tar
        rm art_files.tar
        cd -
        mntroot_ro
    fi
    if ! [ -f ${WIFI_TEST_UTIL} ]; then
        failure "can not extract ART"
        do_print_art_header
        let line_number=$?
        ${DOUT} -n 8 $line_number "Cannot find ART utility"
        let line_number+=2
        ${DOUT}    8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."
        wait_for_key $EXIT_KEY
        return $WIFI_FAILED
    fi
    return $WIFI_SUCCESS
}

######################################################################
# Function:    do_run_wifi_art_run_test
# Purpose:     Wifi test utility using ART
#              Level 4: run the test.
# Paramters:   none
# Returns:     none
######################################################################

do_run_wifi_art_run_test()
{
    do_print_art_header
    line_number=$?
    ${DOUT}    8 $line_number "Loading ART"

    do_extract_art
    _status="$?"
    if [ $_status -ne $WIFI_SUCCESS]; then
        failure "wifi art run test failed, cannot find ART util"
        return ${WIFI_FAILED}
    fi


    ${WIFI_TEST_UTIL} -s FCC
    return ${WIFI_SUCCESS}
}


######################################################################
# Function:    do_run_wifi_art_automation_diag
# Purpose:     Wifi automation test utility using ART
#              Choose WIFI Band, US or EU
#              Choose channel to test: 
#                   * US: 1, 6, 11
#                   * EU: 1, 7, 13
#              Choose Tx or Rx test
#              Choose mode
#              Choose Rate
#              Run the test
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_automation_diag()
{
    
    # Choose WIFI band:  US or EU
    do_run_wifi_art_choose_wifi_band
    RETURN_VAL=$?
    if [ ${RETURN_VAL} -eq ${WIFI_EXIT} ]; then
        return ${RETURN_VAL}
    fi
    do_run_wifi_art_choose_channel
    RETURN_VAL=$?
    if [ ${RETURN_VAL} -eq ${WIFI_EXIT} ]; then
        return ${RETURN_VAL}
    fi
#    do_run_select_antenna
    do_run_wifi_art_choose_test
    RETURN_VAL=$?
    if [ ${RETURN_VAL} -eq ${WIFI_EXIT} ]; then
        return ${RETURN_VAL}
    fi

    if [ $WIFI_MODE = "11B" ]; then
        do_run_wifi_art_choose_rate_11b
    else
        do_run_wifi_art_choose_rate_11g
    fi
    RETURN_VAL=$?
    if [ ${RETURN_VAL} -eq ${WIFI_EXIT} ]; then
        return ${RETURN_VAL}
    fi
    echo="band = $WIFI_BAND, channel = $WIFI_FREQ, test = $WIFI_ART_TEST"
    echo="mode = $WIFI_MODE"
    echo="data rate idx = $WIFI_DATA_RATE_INDEX, targetPower = $WIFI_USE_TARGET_POWER"
    # run and display menu for use to terminate the test.
    do_run_wifi_art_run_test
    RETURN_VAL=$?
    return ${RETURN_VAL}
}

wait_user_cancel()
{
    clear_screen
    ${DOUT} -n 10 4 "USB Device Mode Diagnostics"
    ${DOUT} -n 8 5 "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    ${DOUT} -n 8 8 "The USB volume has been exported."
    ${DOUT} -n 2 11 "Copy data between the USB exported volume"
    ${DOUT} -n 3 12 "and the PC.  Verify checksum of the copies."
    ${DOUT} 2 15 "Press $SUCCESS_KEY_LABEL to stop test and return to diag menu."
                            
    wait_for_key $SUCCESS_KEY
                                
}
######################################################################
# Function:     do_run_usb_device_diag
# Purpose:      Run the main usb device mode diagnostic test.  This
#               test exports the usb volume, tells the operator to
#               copy data to/from the volume and then verify the results.
# Paramters:    none
# Returns:      none
# Side Effect:  SUB_TEST_PASSED is cleared on any failure
######################################################################
do_run_usb_device_diag()
{
    #
    # Tell user to plug in USB, then export the usb volumes
    #
    do_export_usb_volumes "USB Device Mode Diagnostics"
                
    #
    # Wait for user to end the test
    #
    wait_user_cancel
                                
    #
    # Unexport the volume
    #
    un_export_usb_volumes
}
                                                

######################################################################
# Function:    do_run_wifi_art_factory_diag
# Purpose:     Wifi automation test utility using ART
#              Run the factory test
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_factory_diag()
{
    echo " wifi_factory diag"
    do_extract_art
    _status="$?"
    if [ $_status -ne $WIFI_SUCCESS ]; then
        failure "wifi art factory diag failed.  Cannot find ART"
        return $WIFI_FAILED
    fi

    # more test here
    do_print_art_header                                                           
    line_number=$?                                                                
    ${DOUT}    8 $line_number "Loading ART"

    ${WIFI_TEST_UTIL} -s device_test             
    # don't need to export the USB mode any more                                     
#    do_run_usb_device_diag
    return $_exit_code

}

######################################################################
# Function:    do_run_wifi_art_factory_host_AP_emulation
# Purpose:     Wifi automation test utility using ART
#              Run the factory host AP emulation test
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_factory_host_AP_emulation()
{
    echo " wifi_factory diag"
    do_extract_art
    _status="$?"
    if [ $_status -ne $WIFI_SUCCESS ]; then
        failure "wifi art factory diag failed.  Cannot find ART"
        return $WIFI_FAILED
    fi

    # more test here
    do_print_art_header                                                           
    line_number=$?                                                                
    ${DOUT}    8 $line_number "Loading ART"

    ${WIFI_TEST_UTIL} -s device_host                                                  
#    do_run_usb_device_diag
    return $_exit_code

}


######################################################################
# Function:     do_wifi_menu
# Purpose:      Select between different wifi test mode
#               - Wifi ART automation test
#               - Wifi ART interaction test
#               
# Paramters:    none
# Returns:      none
######################################################################

do_wifi_menu()
{
    do_extract_art
    _status="$?"
    if [ $_status -ne $WIFI_SUCCESS ]; then
        failure "Wifi menu: Cannot load ART"
        return 
    fi
    
    do_print_art_header
    line_number=$?
    ${DOUT} -n 2 $line_number "Select WIFI TEST            "
    let line_number+=2
    text=`keycode_to_label $WIFI_MENU_ITEM_2`
    ${DOUT} -n 2 $line_number "$text) ART 11b automation test"
    let line_number+=2
    text=`keycode_to_label $WIFI_MENU_ITEM_3`
    ${DOUT} -n 2 $line_number "$text) ART 11g automation test"
    let line_number+=2
    text=`keycode_to_label $WIFI_MENU_ITEM_4`
    ${DOUT} -n 2 $line_number "$text) ART 11g factory test"
    let line_number+=2
    text=`keycode_to_label $WIFI_MENU_ITEM_5`
    ${DOUT} -n 2 $line_number "$text) ART 11g interactive test"
    let line_number+=2
    text=`keycode_to_label $WIFI_MENU_ITEM_6`
    ${DOUT} -n 2 $line_number "$text) ART host AP emulation"


    let line_number+=2
    ${DOUT} 8 $line_number "Press $EXIT_KEY_LABEL to exit WIFI Diagnostics."

    DONE=0
    WIFI_RESULT=${WIFI_SUCCESS}
    while [ $DONE -eq 0 ]; do
         KEY=`$GET_KEYBOARD_INPUT`
         RETVAL=$?
         if [ $RETVAL -eq 0 ]; then
         
             #
             # Process key request
             case "$KEY" in
             
             $WIFI_MENU_ITEM_2)
                echo "WIFI ART 11b automation selected..."
                vmsg "Starting WIFI ART 11b test"
                WIFI_MODE="11B"
                do_run_wifi_art_automation_diag
                WIFI_RESULT=$?
                DONE=1
                ;;
             $WIFI_MENU_ITEM_3)
                echo "WIFI ART 11g automation selected..."
                vmsg "Starting WIFI ART 11g test"
                WIFI_MODE="11G"
                do_run_wifi_art_automation_diag
                WIFI_RESULT=$?
                DONE=1
                ;;

             $WIFI_MENU_ITEM_4)
                echo "WIFI ART factory test selected..."
                vmsg "Starting WIFI ART factory test"
                do_run_wifi_art_factory_diag
                WIFI_RESULT=$?
                DONE=1
                ;;
                                           
             $WIFI_MENU_ITEM_5)
                echo "WIFI ART interaction selected..."
                vmsg "Starting WIFI ART test"
                WIFI_MODE=WIFI_11G
                do_run_wifi_art_interaction_diag
                WIFI_RESULT=$?
                DONE=1
                ;;

             $WIFI_MENU_ITEM_6)
                echo "WIFI ART AP host emulation selected..."
                vmsg "Starting WIFI AP host emulation"
                WIFI_MODE=WIFI_11G
                do_run_wifi_art_factory_host_AP_emulation
                WIFI_RESULT=$?
                DONE=1
                ;;
                
             
            $EXIT_KEY)
                # User pressed the target key, verify visual via asking operator
                DONE=1
                return ${WIFI_EXIT}
                ;;
            *)
                DONE=0
                ;;
             
             esac
         fi
    done
    return ${WIFI_RESULT}
}

######################################################################
# Function:    do_run_wifi_art_interaction_diag
# Purpose:     Wifi automation test utility using ART
#              Level 1: Choose WIFI Band, US or EU
#              Level 2: Choose channel to test: 
#                   * US: 1, 6, 11
#                   * EU: 1, 7, 13
#              Level 3: Choose Tx or Rx test
#              Level 4: Run the test
# Paramters:   none
# Returns:     none
######################################################################
do_run_wifi_art_interaction_diag()
{
    do_print_art_header
    line_number=$?
    ${DOUT}    8 $line_number "Loading ART"
    # run art here
    do_extract_art
    _status="$?"
    if [ $_status -eq $WIFI_SUCCESS ]; then
        ${WIFI_TEST_UTIL} -s interactive
    else
        failure "$WIFI_TEST_UTIL  not found"
        return ${WIFI_FAILED}
    fi
    return ${WIFI_SUCCESS}
}


# USB Hal for exporting USB volume
[ -f ${_USB_HAL_FUNCTIONS} ] && . ${_USB_HAL_FUNCTIONS}

# Keyboard HAL
[ -f ${_KEYBOARD_HAL_FUNCTIONS} ] && . ${_KEYBOARD_HAL_FUNCTIONS}

# Don't include HAL more than once
if [ "x$_WIFI_HAL_INCLUDED" == "x1" ]; then
    return 0
fi

export WIFI_SUCCESS=0
export WIFI_FAILED=1
export WIFI_EXIT=2                                             
export ART_ROOT="${ART_ROOT:-${DIAGNOSTIC_ROOT}/tests/wifi/${WIFI_ART_BASE}}"
export WIFI_TEST_UTIL="${ART_ROOT}/deviceArt.sh"

#
# Constants for WiFi 511 test
#
export WIFI_511_RESULTS_TMP_FILE="/tmp/511.log"
export WIFI_511_RESULTS_FILENAME="${PRODUCT_NAME}-511.log"
export WIFI_511_RESULTS_OUTPUT_FILE="/tmp/${WIFI_511_RESULTS_FILENAME}"


# Power State Constants
export WIFI_POWER_OFF=0
export WIFI_POWER_ON=1


# WIFI Antenna
export WIFI_ANT_MENU_ITEM_1=$KEY_A
export WIFI_ANT_MENU_ITEM_2=$KEY_B

# WIFI US BAND
export WIFI_BAND_MENU_ITEM_1=$KEY_U
# WIFI EU BAND
export WIFI_BAND_MENU_ITEM_2=$KEY_E

# US band channel 1, 2412 MHz
export WIFI_US_CH_MENU_ITEM_1=$KEY_Q
# US band channel 6, 2437 MHz
export WIFI_US_CH_MENU_ITEM_2=$KEY_W
# US band channel 11, 2462 MHz
export WIFI_US_CH_MENU_ITEM_3=$KEY_E
# EU band channel 1, 2412 MHz
