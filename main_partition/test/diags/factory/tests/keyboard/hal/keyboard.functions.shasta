#!/bin/sh
######################################################################
#
#  File:   keyboard.functions.shasta
#
#  Author: Nick Vaccaro <nvaccaro@lab126.com>
#
#  Date:   07/22/09
#
#  Copyright 2008, Lab126, Inc.  All rights reserved.
#
#  Description:
#      Shasta Keyboard HAL layer for diagnostic keyboard scripts.  This file
#   defines various HAL routines that map to the Shasta keyboard
#
#   Data Structures
#       KEY_TEST_ARRAY - array of keys by keycodes that are to be tested
#
#   Routines
#       label_to_keycode()  - converts a key label to its keycode value
#       keycode_to_label()  - converts a keycode to char label on key
#       keyboard_test_pcb() - Test the pcb keyboard for shorts
#       keyboard_hal_init() - Keyboard hal init
#       keyboard_hal_exit() - Keyboard hal exit
#
######################################################################


######################################################################
# Function:     label_to_keycode
# Purpose:      Return the keycode for the key cooresponding to the
#               passed in label string.
# Parameters:   String/character representing the key
# Returns:      Echo's the keycode
######################################################################
label_to_keycode()
{
    case "$1" in

    1) echo $KEY_1 ;;
    2) echo $KEY_2 ;;
    3) echo $KEY_3 ;;
    4) echo $KEY_4 ;;
    5) echo $KEY_5 ;;
    6) echo $KEY_6 ;;
    7) echo $KEY_7 ;;
    8) echo $KEY_8 ;;
    9) echo $KEY_9 ;;
    0) echo $KEY_0 ;;
    Q) echo $KEY_Q ;;
    W) echo $KEY_W ;;
    E) echo $KEY_E ;;
    R) echo $KEY_R ;;
    T) echo $KEY_T ;;
    Y) echo $KEY_Y ;;
    U) echo $KEY_U ;;
    I) echo $KEY_I ;;
    O) echo $KEY_O ;;
    P) echo $KEY_P ;;
    A) echo $KEY_A ;;
    S) echo $KEY_S ;;
    D) echo $KEY_D ;;
    F) echo $KEY_F ;;
    G) echo $KEY_G ;;
    H) echo $KEY_H ;;
    J) echo $KEY_J ;;
    K) echo $KEY_K ;;
    L) echo $KEY_L ;;
    Z) echo $KEY_Z ;;
    X) echo $KEY_X ;;
    C) echo $KEY_C ;;
    V) echo $KEY_V ;;
    B) echo $KEY_B ;;
    N) echo $KEY_N ;;
    M) echo $KEY_M ;;

    #BACKSPACE) echo $KEY_BACKSPACE ;;
    #DOT) echo $KEY_DOT ;;
    #SLASH) echo $KEY_SLASH ;;
    #ENTER) echo $KEY_ENTER ;;
    #SHIFT) echo $KEY_SHIFT ;;
    #ALT) echo $KEY_ALT ;;
    #SPACE) echo $KEY_SPACE ;;
    #aA) echo $KEY_FONT ;;
    #@) echo $KEY_AT ;;
    #SYM) echo $KEY_SYM ;;
    #123) echo $KEY_123 ;;

    *) echo "?" ;;

    esac
}


######################################################################
# Function:     keycode_to_label
# Purpose:      Return the string representing the passed-in keycode
# Parameters:   keycode of key to get label for
# Returns:      Echo's the key name string
######################################################################
keycode_to_label()
{
    case "$1" in

    $KEY_1) echo "1" ;;
    $KEY_2) echo "2" ;;
    $KEY_3) echo "3" ;;
    $KEY_4) echo "4" ;;
    $KEY_5) echo "5" ;;
    $KEY_6) echo "6" ;;
    $KEY_7) echo "7" ;;
    $KEY_8) echo "8" ;;
    $KEY_9) echo "9" ;;
    $KEY_0) echo "0" ;;
    $KEY_Q) echo "Q" ;;
    $KEY_W) echo "W" ;;
    $KEY_E) echo "E" ;;
    $KEY_R) echo "R" ;;
    $KEY_T) echo "T" ;;
    $KEY_Y) echo "Y" ;;
    $KEY_U) echo "U" ;;
    $KEY_I) echo "I" ;;
    $KEY_O) echo "O" ;;
    $KEY_P) echo "P" ;;
    $KEY_A) echo "A" ;;
    $KEY_S) echo "S" ;;
    $KEY_D) echo "D" ;;
    $KEY_F) echo "F" ;;
    $KEY_G) echo "G" ;;
    $KEY_H) echo "H" ;;
    $KEY_J) echo "J" ;;
    $KEY_K) echo "K" ;;
    $KEY_L) echo "L" ;;
    $KEY_BACKSPACE) echo "DEL" ;;
    $KEY_Z) echo "Z" ;;
    $KEY_X) echo "X" ;;
    $KEY_C) echo "C" ;;
    $KEY_V) echo "V" ;;
    $KEY_B) echo "B" ;;
    $KEY_N) echo "N" ;;
    $KEY_M) echo "M" ;;
    $KEY_DOT) echo "." ;;
    $KEY_SLASH) echo "/" ;;
    $KEY_ENTER) echo "ENTER" ;;
    $KEY_SHIFT) echo "SHIFT" ;;
    $KEY_ALT) echo "ALT" ;;
    $KEY_SPACE) echo "SPACE" ;;
    $KEY_FONT) echo "Aa" ;;
    $KEY_SYM) echo "SYM" ;;
    $KEY_123) echo "123" ;;

    $BUTTON_LEFT_PREV_PAGE)     echo "Left <" ;;
    $BUTTON_LEFT_NEXT_PAGE)     echo "Left >" ;;
    $BUTTON_RIGHT_PREV_PAGE)    echo "Right <" ;;
    $BUTTON_RIGHT_NEXT_PAGE)    echo "Right >" ;;
    $BUTTON_HOME)               echo "HOME" ;;
    $BUTTON_MENU)               echo "MENU" ;;
    $BUTTON_BACK)               echo "BACK" ;;
    $VOLUME_UP)                 echo "Volume Up" ;;
    $VOLUME_DOWN)               echo "Volume Down" ;;

    *) echo "?" ;;

    esac
}


######################################################################
# Function:     keyboard_test_pcb
# Purpose:      Test the pcb keyboard to assure there aren't any shorts.
#               Watch for the test duration time and assure no key events
#               are seen.
#
#               Possible Improvement: Completion string from SSP fixture when
#                   test is actually complete.  Requires more SSP-side mods
# Parameters:   none
# Returns:      0 - Test failure
#               1 - Test success
######################################################################
keyboard_test_pcb()
{
    # Look for a short
    vmsg "keyboard_test_pcb()"

    #
    # We'll look for events from other input sources as well as 
    # just keypad (we shouldn't see button events on a keypad touch or
    # we have a board problem...
    #
    KEY=`$GET_KEYBOARD_INPUT $KEYBOARD_PCB_KEYPAD_TIMEOUT`
    RETVAL=$?
    if [ $RETVAL -eq 0 ]; then
        FAIL_KEY_LABEL=`keycode_to_label $KEY`
        failure "PCB Keypad Diagnostic saw $FAIL_KEY_LABEL ($KEY)"
        local_key_test_passed=0
    else
        local_key_test_passed=1
    fi
    return $local_key_test_passed
}


######################################################################
# Function:     keyboard_hal_init
# Purpose:      Keyboard hal initialization routine.  Nothing to do here.
# Parameters:   none
# Returns:      none
######################################################################
keyboard_hal_init()
{
    #
    # Nothing to initialize for keyboard hal
    #
    vmsg "keyboard_hal_init()"
}


######################################################################
# Function:     keyboard_hal_exit
# Purpose:      Keyboard hal exit routine.  Nothing to do here.
# Parameters:   none
# Returns:      none
######################################################################
keyboard_hal_exit()
{
    #
    # Nothing to uninitialize for keyboard hal
    #
    vmsg "keyboard_hal_exit()"
}
if [ "x$_KEYBOARD_HAL_INCLUDED" == "x1" ]; then
    return 0
fi


#
# Key test array (keys to test)
# In order of right to left, top to bottom
#
export KEY_TEST_ARRAY="$KEY_Q $KEY_W $KEY_E $KEY_R $KEY_T $KEY_Y $KEY_U $KEY_I $KEY_O $KEY_P $KEY_A $KEY_S $KEY_D $KEY_F $KEY_G $KEY_H $KEY_J $KEY_K $KEY_L $KEY_BACKSPACE $KEY_Z $KEY_X $KEY_C $KEY_V $KEY_B $KEY_N $KEY_M $KEY_DOT $KEY_SYM $KEY_ENTER $KEY_SHIFT $KEY_SPACE $KEY_FONT"


#
# Timeout in ms to wait for keypad input in keypad PCB test
#
export KEYBOARD_PCB_KEYPAD_TIMEOUT=3000

export _KEYBOARD_HAL_INCLUDED=1
